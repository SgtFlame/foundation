{
  "id": "fn-calendar-createEvent",
  "name": "Create an event",
  "description": "Makes an event on a calendar the caller may write, as the caller: a one-off, or a series with rrule. Times are instants (RFC 3339); zone is where it is planned (the calendar's when left out). Gives the new event's id.",
  "kind": "function",
  "version": 1,
  "owner": "app:calendar",
  "nodes": [
    {
      "id": "call",
      "type": "event.call",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "calendar",
            "type": "string",
            "description": "The calendar's id"
          },
          {
            "id": "title",
            "type": "string",
            "description": "The title"
          },
          {
            "id": "start",
            "type": "string",
            "description": "The start, RFC 3339 (midnight UTC of the first day for all-day)"
          },
          {
            "id": "end",
            "type": "string",
            "description": "The end (exclusive), RFC 3339"
          },
          {
            "id": "zone",
            "type": "string",
            "optional": true,
            "description": "The IANA zone it is planned in, e.g. Europe/London"
          },
          {
            "id": "allDay",
            "type": "bool",
            "optional": true,
            "description": "Whole days"
          },
          {
            "id": "rrule",
            "type": "string",
            "optional": true,
            "description": "An RRULE to repeat it, e.g. FREQ=WEEKLY;BYDAY=MO"
          },
          {
            "id": "location",
            "type": "string",
            "optional": true,
            "description": "Where"
          },
          {
            "id": "description",
            "type": "string",
            "optional": true,
            "description": "Notes"
          },
          {
            "id": "attendees",
            "type": "json",
            "optional": true,
            "description": "[{email, name, user}]"
          }
        ]
      }
    },
    {
      "id": "newId",
      "type": "data.newId",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "eventId",
      "type": "data.expression",
      "title": "The new event's id, read once",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "string(fresh)",
        "type": "string"
      }
    },
    {
      "id": "args",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "expr": "{entity: \"calEvent\", values: {calendar: calendar, title: title, start: start, end: end, zone: zone ?? \"\", allDay: allDay ?? false, rrule: rrule ?? \"\", location: location ?? \"\", description: description ?? \"\", attendees: map(attendees ?? [], fromPairs(concat(toPairs(#), [[\"response\", #.response ?? \"needsAction\"]]))), status: \"confirmed\", transparency: \"opaque\"}}",
        "type": "json"
      }
    },
    {
      "id": "send",
      "type": "live.sendCommand",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "command": "record.create"
      }
    },
    {
      "id": "ok",
      "type": "flow.return",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "id",
            "type": "string"
          },
          {
            "id": "produced",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "produced",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "{entity: \"calEvent\", id: id}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "flow.return",
      "position": {
        "x": 1020,
        "y": 200
      },
      "config": {
        "outputs": [
          {
            "id": "error",
            "type": "string"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "call",
        "pin": "calendar"
      },
      "to": {
        "node": "args",
        "pin": "calendar"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "title"
      },
      "to": {
        "node": "args",
        "pin": "title"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "start"
      },
      "to": {
        "node": "args",
        "pin": "start"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "end"
      },
      "to": {
        "node": "args",
        "pin": "end"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "zone"
      },
      "to": {
        "node": "args",
        "pin": "zone"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "allDay"
      },
      "to": {
        "node": "args",
        "pin": "allDay"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "rrule"
      },
      "to": {
        "node": "args",
        "pin": "rrule"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "location"
      },
      "to": {
        "node": "args",
        "pin": "location"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "description"
      },
      "to": {
        "node": "args",
        "pin": "description"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "attendees"
      },
      "to": {
        "node": "args",
        "pin": "attendees"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "then"
      },
      "to": {
        "node": "send",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "newId",
        "pin": "id"
      },
      "to": {
        "node": "eventId",
        "pin": "fresh"
      }
    },
    {
      "from": {
        "node": "eventId",
        "pin": "value"
      },
      "to": {
        "node": "send",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "args",
        "pin": "value"
      },
      "to": {
        "node": "send",
        "pin": "args"
      }
    },
    {
      "from": {
        "node": "send",
        "pin": "ok"
      },
      "to": {
        "node": "ok",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "eventId",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "eventId",
        "pin": "value"
      },
      "to": {
        "node": "produced",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "produced",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "produced"
      }
    },
    {
      "from": {
        "node": "send",
        "pin": "rejected"
      },
      "to": {
        "node": "refused",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "send",
        "pin": "message"
      },
      "to": {
        "node": "refused",
        "pin": "error"
      }
    }
  ]
}
