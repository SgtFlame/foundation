        "node": "why",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "true"
      },
      "to": {
        "node": "no",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "why",
        "pin": "value"
      },
      "to": {
        "node": "no",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "w0list",
        "pin": "plan"
      }
    },
    {
      "from": {
