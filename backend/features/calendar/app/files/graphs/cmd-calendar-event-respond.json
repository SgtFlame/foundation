{
  "id": "cmd-calendar-event-respond",
  "name": "calendar.event.respond",
  "description": "Answers an invitation for the caller: sets the response of their own attendee entry on the target event (accepted, tentative or declined, with a comment), and nobody else's.",
  "kind": "command",
  "version": 1,
  "owner": "app:calendar",
  "spec": {
    "command": "event.respond",
    "title": "Answer an invitation",
    "description": "Sets the caller's own attendee response on the target event: answer accepted, tentative or declined, and an optional comment. Refused when the caller is not an attendee.",
    "args": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "enum": [
            "accepted",
            "tentative",
            "declined"
          ],
          "description": "The answer"
        },
        "comment": {
          "type": "string",
          "description": "A note to the organizer"
        }
      },
      "required": [
        "answer"
      ]
    },
    "area": "rec",
    "targetType": "calEvent",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "let me = string(user ?? \"\");\nlet ats = ev?.attendees ?? [];\nlet mine = any(ats, string(#.user ?? \"\") == me);\n{problem: ev == nil ? \"there is no event \" + target\n  : !(args.answer in [\"accepted\", \"tentative\", \"declined\"]) ? \"the answer is accepted, tentative or declined\"\n  : !mine ? \"you are not invited to this event\" : \"\",\n eventUpdate: [{id: target, set: {attendees: map(ats, string(#.user ?? \"\") == me ? fromPairs(concat(toPairs(#), [[\"response\", args.answer], [\"comment\", args.comment ?? \"\"]])) : #)}, expect: ev?._seq}]}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1020,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "expr": "plan.eventUpdate ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "update calEvent (eventUpdate)",
      "position": {
        "x": 1360,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.update",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "entity": "calEvent"
      }
    },
    {
      "id": "w0s",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 200
      },
      "config": {
        "expr": "item.set",
        "type": "json"
      }
    },
    {
      "id": "w0x",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 400
      },
      "config": {
        "expr": "item.expect",
        "type": "number"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "args"
      },
      "to": {
        "node": "plan",
        "pin": "args"
      }
    },
    {
