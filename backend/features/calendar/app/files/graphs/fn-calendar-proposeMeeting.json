{
  "id": "fn-calendar-proposeMeeting",
  "name": "Propose a meeting",
  "description": "Finds times when everyone is free (as findFreeTime does) and holds them for the proposal (as hold does), returning the slots to put in a draft; it never sends anything itself. An agent whose autonomy is suggest gets the slots only, with no Hold. Args {people, durationMinutes, from, to, purpose, subject?, count?}.",
  "kind": "function",
  "version": 1,
  "owner": "app:calendar",
  "nodes": [
    {
      "id": "call",
      "type": "event.call",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "people",
            "type": "json",
            "optional": true,
            "description": "The people's user ids, as text; the caller is always included"
          },
          {
            "id": "durationMinutes",
            "type": "number",
            "description": "The meeting's length in minutes"
          },
          {
            "id": "from",
            "type": "string",
            "description": "The window's start, RFC 3339"
          },
          {
            "id": "to",
            "type": "string",
            "description": "The window's end (exclusive), RFC 3339"
          },
          {
            "id": "purpose",
            "type": "string",
            "description": "What the meeting is for; the held events' title"
          },
          {
            "id": "subject",
            "type": "json",
            "optional": true,
            "description": "What the proposal is about, {entity, id}"
          },
          {
            "id": "count",
            "type": "number",
            "optional": true,
            "description": "How many times to propose, 3 when left out"
          }
        ]
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "everyone",
      "type": "data.expression",
      "title": "The caller and the people named",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "kind == \"agent\" || user == \"\" ? map(people ?? [], string(#)) : uniq(concat([user], map(people ?? [], string(#))))",
        "type": "json"
      }
    },
    {
      "id": "find",
      "type": "flow.callGraph",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "graph": "fn-calendar-findFreeTime",
        "inputs": [
          {
            "id": "people",
            "name": "people",
            "type": "json",
            "optional": true,
            "description": "The people's user ids, as text; the caller (a person) is always included"
          },
          {
            "id": "durationMinutes",
            "name": "durationMinutes",
            "type": "number",
            "description": "The meeting's length in minutes"
          },
          {
            "id": "from",
            "name": "from",
            "type": "string",
            "description": "The window's start, RFC 3339"
          },
          {
            "id": "to",
            "name": "to",
            "type": "string",
            "description": "The window's end (exclusive), RFC 3339"
          },
          {
            "id": "count",
            "name": "count",
            "type": "number",
            "optional": true,
            "description": "How many slots, 3 when left out"
          }
        ],
        "outputs": [
          {
            "id": "slots",
            "name": "slots",
            "type": "json",
            "optional": true
          },
          {
            "id": "count",
            "name": "count",
            "type": "number",
            "optional": true
          },
          {
            "id": "unknown",
            "name": "unknown",
            "type": "json",
            "optional": true
          }
        ]
      }
    },
    {
      "id": "mayHold",
      "type": "data.expression",
      "title": "Slots found, and the caller may hold time",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "found \u003e 0 \u0026\u0026 !(kind == \"agent\" \u0026\u0026 (agentRecord?.autonomy ?? \"draft\") == \"suggest\")",
        "type": "bool"
      }
    },
    {
      "id": "should",
      "type": "flow.branch",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "times",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 200
      },
      "config": {
        "expr": "map(slots ?? [], ({start: #.start, end: #.end}))",
        "type": "json"
      }
    },
    {
      "id": "hold",
      "type": "flow.callGraph",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "graph": "fn-calendar-hold",
        "catch": true,
        "inputs": [
          {
            "id": "slots",
            "name": "slots",
            "type": "json",
            "description": "The times to hold, [{start, end}] in RFC 3339"
          },
          {
            "id": "purpose",
            "name": "purpose",
            "type": "string",
            "description": "What the time is held for; the tentative events' title"
          },
          {
            "id": "subject",
            "name": "subject",
            "type": "json",
            "optional": true,
            "description": "What the proposal is about, {entity, id} (a mail thread, a conversation)"
          },
          {
            "id": "calendar",
            "name": "calendar",
            "type": "string",
            "optional": true,
            "description": "The calendar to hold them on; the caller's first own calendar when left out"
          },
          {
            "id": "zone",
            "name": "zone",
            "type": "string",
            "optional": true,
            "description": "The events' time zone; the calendar's when left out"
          }
        ],
        "outputs": [
          {
            "id": "hold",
            "name": "hold",
            "type": "string",
            "optional": true
          },
          {
            "id": "slots",
            "name": "slots",
            "type": "json",
            "optional": true
          },
          {
            "id": "expires",
            "name": "expires",
            "type": "string",
            "optional": true
          },
          {
            "id": "produced",
            "name": "produced",
            "type": "json",
            "optional": true
          },
          {
            "id": "error",
            "name": "error",
            "type": "string",
            "optional": true
          }
        ]
      }
    },
    {
      "id": "withEvents",
      "type": "data.expression",
      "title": "Each slot with its held event",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "expr": "let held = heldSlots ?? []; map(slots ?? [], let i = #index; let s = #; len(held) \u003e i ? fromPairs(concat(toPairs(s), [[\"event\", held[i].event]])) : s)",
        "type": "json"
      }
    },
    {
      "id": "produced",
      "type": "data.expression",
      "position": {
        "x": 2040,
        "y": 200
      },
      "config": {
        "expr": "(hold ?? \"\") == \"\" ? nil : ({entity: \"calHold\", id: hold})",
        "type": "json"
      }
    },
    {
      "id": "held",
      "type": "flow.return",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "slots",
            "type": "json"
          },
          {
            "id": "hold",
            "type": "string"
          },
          {
            "id": "expires",
            "type": "string"
          },
          {
            "id": "unknown",
            "type": "json"
          },
          {
            "id": "error",
            "type": "string"
          },
          {
            "id": "produced",
            "type": "json"
          }
        ]
      }
    },
    {
      "id": "only",
      "type": "flow.return",
      "position": {
        "x": 2040,
        "y": 400
      },
      "config": {
        "outputs": [
          {
            "id": "slots",
            "type": "json"
          },
          {
            "id": "unknown",
            "type": "json"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "me",
        "pin": "kind"
      },
      "to": {
        "node": "everyone",
        "pin": "kind"
      }
    },
    {
      "from": {
        "node": "me",
        "pin": "user"
      },
      "to": {
        "node": "everyone",
        "pin": "user"
      }
    },
    {
      "from": {
