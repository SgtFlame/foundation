          "calendar": "primary",
          "end": {
            "local": "2026-12-03T11:00:00",
            "zone": "America/New_York"
          },
          "etag": "1",
          "iCalUID": "evt-1@axiom",
          "id": "evt-1",
          "organizer": {
            "email": "tony@example.org"
          },
          "start": {
            "local": "2026-12-03T10:00:00",
            "zone": "America/New_York"
          },
          "status": "confirmed",
          "title": "Renewal call",
          "transparency": "opaque"
        }
      }
