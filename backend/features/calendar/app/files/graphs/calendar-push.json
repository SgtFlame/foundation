            "type": "string",
            "description": "A link to the event"
          },
          {
            "id": "organizer",
            "name": "Organizer",
            "type": "json",
            "description": "Who organizes it"
          },
          {
            "id": "attendees",
            "name": "Attendees",
            "type": "json",
            "description": "Who is invited and their answers"
          },
          {
            "id": "description",
            "name": "Description",
            "type": "string",
            "description": "Its description as plain text"
          },
          {
            "id": "descriptionHtml",
            "name": "DescriptionHtml",
            "type": "string",
            "description": "Its description as HTML, when the service has one"
          },
          {
            "id": "iCalUID",
            "name": "ICalUID",
            "type": "string",
            "description": "Its iCalendar UID, the same at every service"
          },
          {
            "id": "sequence",
            "name": "Sequence",
            "type": "number",
            "description": "Its iCalendar SEQUENCE"
          },
          {
            "id": "updated",
            "name": "Updated",
            "type": "string",
            "description": "When it last changed, RFC 3339"
          }
        ],
        "connection": true,
        "effect": "write",
        "sample": {
