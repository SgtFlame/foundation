{
  "id": "calendar-push",
  "name": "Push an edit to the outside calendar",
  "description": "Sends an edit made here to the event's outside calendar, as a job keyed by the event: event.create keyed by the record's id (so a retried job makes one outside event), then the outside id and etag written back; event.update with the etag the edit was based on, and on conflict the outside version kept, the edit recorded as the event's refusedChange and a delta pull enqueued; event.delete for a deleted event. Does nothing for a calendar without a connection.",
  "kind": "server.action",
  "version": 1,
  "owner": "app:calendar",
  "nodes": [
    {
      "id": "call",
      "type": "event.call",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "record",
            "type": "json",
            "description": "The event as it was after the edit; empty when deleted"
          },
          {
            "id": "old",
            "type": "json",
            "description": "The values the edit replaced (the whole record for a delete)"
          },
          {
            "id": "deleted",
            "type": "bool",
            "description": "The event was deleted"
          }
        ]
      }
    },
    {
      "id": "eventId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "string((record ?? old)?._id ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "cur",
      "type": "records.get",
      "title": "The event now",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "calEvent"
      }
    },
    {
      "id": "calId",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "string(record?.calendar ?? old?.calendar ?? cur?.calendar ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "cal",
      "type": "records.get",
      "title": "Its calendar",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "entity": "calCalendar"
      }
    },
    {
      "id": "masterId",
      "type": "data.expression",
      "title": "Its series master, for an exception",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "(record?.series ?? \"\") != \"\" ? string(record.series) : eventId",
        "type": "string"
      }
    },
    {
      "id": "master",
      "type": "records.get",
      "position": {
        "x": 1020,
        "y": 200
      },
      "config": {
        "entity": "calEvent"
      }
    },
    {
      "id": "clock",
      "type": "data.now",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "zone",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "(record?.zone ?? \"\") != \"\" ? record.zone : ((cal?.zone ?? \"\") != \"\" ? cal.zone : \"UTC\")",
        "type": "string"
      }
    },
    {
      "id": "startIn",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "expr": "string(record?.start ?? \"1970-01-01T00:00:00Z\")",
        "type": "string"
      }
    },
    {
      "id": "endIn",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 400
      },
      "config": {
        "expr": "string(record?.end ?? record?.start ?? \"1970-01-01T00:00:00Z\")",
        "type": "string"
      }
    },
    {
      "id": "startConv",
      "type": "time.convert",
      "title": "The start in its zone",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "endConv",
      "type": "time.convert",
      "title": "The end in its zone",
      "position": {
        "x": 2040,
        "y": 200
      }
    },
    {
      "id": "payload",
      "type": "data.expression",
      "title": "The event as calendar.events@1 takes it",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "let r = record ?? {};\nlet allDay = r.allDay ?? false;\nlet recurs = (r.rrule ?? \"\") != \"\" || len(r.rdate ?? []) \u003e 0;\nlet isException = (r.series ?? \"\") != \"\" \u0026\u0026 (master?.outsideId ?? \"\") != \"\";\nlet p = {title: r.title ?? \"\",\n  start: allDay ? {date: string(r.start)[0:10]} : {local: startLocal, zone: zone},\n  end: allDay ? {date: string(r.end ?? r.start)[0:10]} : {local: endLocal, zone: zone},\n  recurrence: recurs ? {rrule: r.rrule ?? \"\", rdate: r.rdate ?? [], exdate: r.exdate ?? []} : nil,\n  recurrenceId: isException ? (r.recurrenceId ?? \"\") : nil,\n  seriesId: isException ? master.outsideId : nil,\n  status: r.status ?? \"confirmed\", transparency: r.transparency ?? \"opaque\",\n  location: r.location ?? \"\", videoLink: r.videoLink ?? \"\", description: r.description ?? \"\",\n  organizer: r.organizer, attendees: r.attendees,\n  iCalUID: (r.iCalUID ?? \"\") != \"\" ? r.iCalUID : eventId + \"@axiom\"};\nfromPairs(filter(toPairs(p), #[1] != nil))",
        "type": "json"
      }
    },
    {
      "id": "outId",
      "type": "data.expression",
      "title": "Its outside id",
      "position": {
        "x": 1020,
        "y": 400
      },
      "config": {
        "expr": "(cur?.outsideId ?? \"\") != \"\" ? string(cur.outsideId) : string(record?.outsideId ?? old?.outsideId ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "etag",
      "type": "data.expression",
      "title": "The etag the edit was based on",
      "position": {
        "x": 1020,
        "y": 600
      },
      "config": {
        "expr": "(record?.outsideId ?? \"\") != \"\" ? string(record.etag ?? \"\") : string(cur?.etag ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "kind",
      "type": "data.expression",
      "title": "Create, update or delete",
      "position": {
        "x": 1700,
        "y": 200
      },
      "config": {
        "expr": "let connected = cal != nil \u0026\u0026 (cal.connection ?? \"\") != \"\" \u0026\u0026 (cal.outsideId ?? \"\") != \"\";\n!connected ? \"none\" : ((deleted ?? false) ? (outId != \"\" ? \"delete\" : \"none\") : (outId == \"\" ? \"create\" : \"update\"))",
        "type": "string"
      }
    },
    {
      "id": "conn",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 400
      },
      "config": {
        "expr": "string(cal?.connection ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "outCal",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 600
      },
      "config": {
        "expr": "string(cal?.outsideId ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "isCreate",
      "type": "data.expression",
      "position": {
        "x": 2040,
        "y": 400
      },
      "config": {
        "expr": "kind == \"create\"",
        "type": "bool"
      }
    },
    {
      "id": "isUpdate",
      "type": "data.expression",
      "position": {
        "x": 2040,
        "y": 600
      },
      "config": {
        "expr": "kind == \"update\"",
        "type": "bool"
      }
    },
    {
      "id": "isDelete",
      "type": "data.expression",
      "position": {
        "x": 2040,
        "y": 800
      },
      "config": {
        "expr": "kind == \"delete\"",
        "type": "bool"
      }
    },
    {
      "id": "bCreate",
      "type": "flow.branch",
      "position": {
        "x": 2380,
        "y": 200
      }
    },
    {
      "id": "bUpdate",
      "type": "flow.branch",
      "position": {
        "x": 2720,
        "y": 0
      }
    },
    {
      "id": "bDelete",
      "type": "flow.branch",
      "position": {
        "x": 3060,
        "y": 0
      }
    },
    {
      "id": "create",
      "type": "connector.call",
      "title": "Create it outside",
      "position": {
        "x": 2720,
        "y": 200
      },
      "config": {
        "contract": "calendar.events@1",
        "operation": "event.create",
        "inputs": [
          {
            "id": "calendar",
            "name": "Calendar",
            "type": "string",
            "description": "The calendar's id"
