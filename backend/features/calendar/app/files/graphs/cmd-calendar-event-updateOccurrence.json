      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "entity": "calCalendar"
      }
    },
    {
      "id": "zone",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "(state?.zone ?? \"\") != \"\" ? state.zone : (cal?.zone ?? \"\") != \"\" ? cal.zone : \"UTC\"",
        "type": "string"
      }
    },
    {
      "id": "instant",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 400
      },
      "config": {
        "expr": "string(state?.start ?? \"2026-01-01T00:00:00Z\")",
        "type": "string"
      }
    },
    {
      "id": "local",
      "type": "time.convert",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "startZoned",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "(state?.allDay ?? false) ? {date: instant[0:10]} : {local: localTime, zone: zone}",
        "type": "json"
      }
    },
    {
      "id": "splitRule",
      "type": "data.expression",
      "title": "The rule to split (a harmless one when not splitting)",
      "position": {
        "x": 340,
        "y": 600
      },
      "config": {
        "expr": "(args.scope ?? \"\") == \"following\" \u0026\u0026 (state?.rrule ?? \"\") != \"\" ? state.rrule : \"FREQ=DAILY;COUNT=2\"",
        "type": "string"
      }
    },
    {
      "id": "splitAt",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "expr": "(args.scope ?? \"\") == \"following\" \u0026\u0026 (state?.rrule ?? \"\") != \"\" ? (args.recurrenceId ?? \"\") : ((state?.allDay ?? false) ? instant[0:10] : instant)",
        "type": "string"
      }
    },
    {
      "id": "cut",
      "type": "time.splitRule",
      "title": "Split the series at the occurrence",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "split",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "{before: before, beforeEmpty: beforeEmpty, after: after}",
        "type": "json"
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 2720,
        "y": 0
      },
      "config": {
        "expr": "let m = state;\nlet rid = args.recurrenceId ?? \"\";\nlet scope = args.scope ?? \"\";\nlet allowed = [\"title\", \"start\", \"end\", \"location\", \"description\", \"status\", \"transparency\", \"attendees\", \"videoLink\", \"allDay\", \"zone\"];\nlet set = fromPairs(filter(toPairs(args.set ?? {}), #[0] in allowed));\nlet compact = replace(replace(replace(rid, \"-\", \"\"), \":\", \"\"), \"+\", \"\");\nlet ridStart = len(rid) == 10 ? rid + \"T00:00:00Z\" : rid;\nlet dur = m == nil ? duration(\"0s\") : date(m.end) - date(m.start);\nlet base = m == nil ? {} : {calendar: m.calendar, title: m.title, zone: m.zone, allDay: m.allDay ?? false, status: m.status ?? \"confirmed\", transparency: m.transparency ?? \"opaque\", location: m.location, videoLink: m.videoLink, organizer: m.organizer, attendees: m.attendees, description: m.description};\nlet at = {start: ridStart, end: date(ridStart).Add(dur).UTC().Format(\"2006-01-02T15:04:05Z\")};\nlet exc = find(exceptions ?? [], #.recurrenceId == rid);\nlet whole = scope == \"all\" || (scope == \"following\" \u0026\u0026 cutAt.beforeEmpty);\nlet later = filter(exceptions ?? [], #.recurrenceId \u003e= rid \u0026\u0026 len(#.recurrenceId) == len(rid));\nlet newId = target + \"_f_\" + compact;\n{problem: m == nil ? \"there is no event \" + target\n  : m.series != nil ? \"the target is an exception: send it to its series' master\"\n  : (m.rrule ?? \"\") == \"\" ? \"the event does not repeat: change it with record.update\"\n  : rid == \"\" ? \"give the occurrence's recurrence id\"\n  : !(scope in [\"this\", \"following\", \"all\"]) ? \"the scope is this, following or all\"\n  : len(set) == 0 ? \"set changes nothing\" : \"\",\n exceptionCreate: scope == \"this\" \u0026\u0026 exc == nil ? [{id: target + \"_x_\" + compact, values: fromPairs(concat(toPairs(base), toPairs(at), [[\"series\", target], [\"recurrenceId\", rid]], toPairs(set)))}] : [],\n exceptionUpdate: scope == \"this\" \u0026\u0026 exc != nil ? [{id: exc._id, set: set, expect: exc._seq}]\n   : (scope == \"following\" \u0026\u0026 !cutAt.beforeEmpty ? map(later, ({id: #._id, set: {series: newId}, expect: #._seq})) : []),\n masterUpdate: whole ? [{id: target, set: set, expect: m._seq}]\n   : scope == \"following\" ? [{id: target, set: {rrule: cutAt.before}, expect: m._seq}] : [],\n seriesCreate: scope == \"following\" \u0026\u0026 !cutAt.beforeEmpty ? [{id: newId, values: fromPairs(concat(toPairs(base), toPairs(at), [[\"rrule\", cutAt.after], [\"rdate\", m.rdate], [\"exdate\", m.exdate]], toPairs(set)))}] : []}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 3060,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
