{
  "id": "cmd-calendar-event-updateOccurrence",
  "name": "calendar.event.updateOccurrence",
  "description": "Changes one occurrence of a recurring event (the target, the series' master), this one, this and the following, or all: this writes or changes an exception for it; following ends the series just before it and starts a new series from it (Split recurrence), carrying the later exceptions over; all changes the master. set holds the event fields to change (title, start, end, location, …).",
  "kind": "command",
  "version": 1,
  "owner": "app:calendar",
  "spec": {
    "command": "event.updateOccurrence",
    "title": "Change an occurrence of a series",
    "description": "Changes an occurrence of the target recurring event (its master): recurrenceId names the occurrence, scope this, following or all, set the fields to change (title, start, end, location, description, status, transparency, attendees, videoLink). Its target is the series' master.",
    "args": {
      "type": "object",
      "properties": {
        "recurrenceId": {
          "type": "string",
          "description": "The occurrence's recurrence id (its original start as an instant in UTC, or a date for all-day)"
        },
        "scope": {
          "type": "string",
          "enum": [
            "this",
            "following",
            "all"
          ],
          "description": "this occurrence, this and the following, or all of them"
        },
        "set": {
          "type": "object",
          "description": "The fields to change, such as {\"title\":\"Planning (moved)\",\"start\":\"2026-12-08T10:00:00Z\",\"end\":\"2026-12-08T11:00:00Z\"}"
        }
      },
      "required": [
        "recurrenceId",
        "scope",
        "set"
      ]
    },
    "area": "rec",
    "targetType": "calEvent",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
