{
  "id": "cmd-calendar-event-mirror",
  "name": "calendar.event.mirror",
  "description": "Mirrors one outside event into the target event record (the sync job picks it: the record already holding the outside id, the record an event made here was created from, or an id made from the calendar and the outside id, so a second mirror finds the same record): made when new, changed when its etag moved, left alone when the etag is the one it holds (an edit of ours coming back), deleted when removed. Sent by the sync job as the app.",
  "kind": "command",
  "version": 1,
  "owner": "app:calendar",
  "spec": {
    "command": "event.mirror",
    "title": "Mirror an outside event",
    "description": "Mirrors one outside event (calendar.events@1's shape) into the target event record of a connected calendar: made when new, changed when its etag moved, left alone when it holds that etag already, deleted when removed is true. Sent by the app's sync job.",
    "args": {
      "type": "object",
      "properties": {
        "calendar": {
          "type": "string",
          "description": "The calendar record's id"
        },
        "event": {
          "type": "object",
          "description": "The outside event, as calendar.events@1 gives it: {id, etag, title, start, end, recurrence, recurrenceId, seriesId, status, ...}"
        },
        "removed": {
          "type": "boolean",
          "description": "True when the outside event was removed"
        },
        "series": {
          "type": "string",
          "description": "For an exception, the id of its series master's record (the sync job finds it from the event's seriesId)"
        }
      },
      "required": [
        "calendar"
      ]
    },
    "area": "rec",
    "targetType": "calEvent",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "calId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "string(args.calendar ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "cal",
      "type": "records.get",
      "title": "The calendar",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "calCalendar"
      }
    },
    {
      "id": "startIn",
      "type": "data.expression",
      "title": "The start's local time",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "expr": "(args.event?.start?.local ?? \"\") != \"\" ? args.event.start.local : \"1970-01-01T00:00:00\"",
        "type": "string"
      }
    },
    {
      "id": "endIn",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 400
      },
      "config": {
        "expr": "(args.event?.end?.local ?? \"\") != \"\" ? args.event.end.local : \"1970-01-01T00:00:00\"",
        "type": "string"
      }
    },
    {
      "id": "startZone",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 600
      },
      "config": {
        "expr": "(args.event?.start?.zone ?? \"\") != \"\" ? args.event.start.zone : \"UTC\"",
        "type": "string"
      }
    },
    {
      "id": "endZone",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 800
      },
      "config": {
        "expr": "(args.event?.end?.zone ?? \"\") != \"\" ? args.event.end.zone : ((args.event?.start?.zone ?? \"\") != \"\" ? args.event.start.zone : \"UTC\")",
        "type": "string"
      }
    },
    {
      "id": "startConv",
      "type": "time.convert",
      "title": "The start as an instant",
      "position": {
        "x": 680,
        "y": 200
      }
    },
    {
      "id": "endConv",
      "type": "time.convert",
      "title": "The end as an instant",
      "position": {
        "x": 680,
        "y": 400
      }
    },
    {
      "id": "startAt",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "(args.event?.start?.date ?? \"\") != \"\" ? args.event.start.date + \"T00:00:00Z\" : conv",
        "type": "string"
      }
    },
    {
      "id": "endAt",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 200
      },
      "config": {
        "expr": "(args.event?.end?.date ?? \"\") != \"\" ? args.event.end.date + \"T00:00:00Z\" : conv",
        "type": "string"
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "let e = args.event ?? {};\nlet gone = args.removed ?? false;\nlet allDay = (e.start?.date ?? \"\") != \"\";\nlet zone = (e.start?.zone ?? \"\") != \"\" ? e.start.zone : ((cal?.zone ?? \"\") != \"\" ? cal.zone : \"UTC\");\nlet seriesId = (args.series ?? \"\") != \"\" ? args.series : nil;\nlet want = {calendar: args.calendar, title: e.title ?? \"\", start: startAt, end: endAt, zone: allDay ? \"\" : zone, allDay: allDay,\n  rrule: e.recurrence?.rrule ?? \"\", rdate: e.recurrence?.rdate ?? [], exdate: e.recurrence?.exdate ?? [], series: seriesId, recurrenceId: e.recurrenceId ?? \"\",\n  status: e.status ?? \"confirmed\", transparency: e.transparency ?? \"opaque\", location: e.location ?? \"\", videoLink: e.videoLink ?? \"\",\n  organizer: e.organizer, attendees: e.attendees ?? [], description: e.description ?? \"\", outsideId: e.id ?? \"\", etag: e.etag ?? \"\", iCalUID: e.iCalUID ?? \"\"};\nlet changed = state == nil ? {} : fromPairs(filter(toPairs(want), { let k = #[0]; toJSON(state[k]) != toJSON(#[1]) \u0026\u0026 !(state[k] == nil \u0026\u0026 (#[1] == \"\" || #[1] == nil)) }));\n{problem: (args.calendar ?? \"\") == \"\" ? \"name the calendar\" : (state != nil \u0026\u0026 string(state.calendar ?? \"\") != args.calendar ? \"that event is another calendar's\" : \"\"),\n creates: !gone \u0026\u0026 state == nil ? [{id: target, values: want}] : [],\n updates: !gone \u0026\u0026 state != nil \u0026\u0026 (state.etag ?? \"\") != (e.etag ?? \"\") \u0026\u0026 len(changed) \u003e 0 ? [{id: target, set: changed, expect: state._seq}] : [],\n deletes: gone \u0026\u0026 state != nil ? [{id: target}] : []}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
