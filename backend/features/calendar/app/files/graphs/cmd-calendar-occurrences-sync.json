{
  "id": "cmd-calendar-occurrences-sync",
  "name": "calendar.occurrences.sync",
  "description": "Keeps the occurrences of an event (the target: a one-off or a series' master) in step with it inside its calendar's window: one per repetition of its rule, an exception's own in place of the one it replaces, none for a cancelled or deleted event. Sent by the app when an event changes and as the window slides; running it twice changes nothing.",
  "kind": "command",
  "version": 1,
  "owner": "app:calendar",
  "spec": {
    "command": "occurrences.sync",
    "title": "Sync an event's occurrences",
    "description": "Keeps the occurrences of an event (the target: a one-off or a series' master) in step with it inside its calendar's window: one per repetition, an exception's own in place of the one it replaces, none for a cancelled or deleted event. Sent by the app; running it twice changes nothing.",
    "args": {
      "type": "object",
      "properties": {
        "now": {
          "type": "string",
          "description": "The instant the window is measured from (RFC 3339); the current time when left out"
        },
        "from": {
          "type": "string",
          "description": "Sync only the occurrences whose slot (recurrence id) is at or after this instant (RFC 3339, e.g. 2026-12-01T00:00:00Z), within the calendar's window: a sync of a long series is sent in slices (calendar's Sync an event)"
        },
        "to": {
          "type": "string",
          "description": "Sync only the occurrences whose slot is before this instant (RFC 3339)"
        }
      }
    },
    "area": "rec",
    "targetType": "calEvent",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "calId",
      "type": "data.expression",
      "title": "The calendar's id",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "string(state?.calendar ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "cal",
      "type": "records.get",
      "title": "The calendar",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "calCalendar"
      }
    },
    {
      "id": "clock",
      "type": "data.now",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "window",
      "type": "data.expression",
      "title": "The calendar's window, or the slice of it asked for",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "let n = (args?.now ?? \"\") != \"\" ? date(args.now) : date(clock);\nlet cf = (cal?.windowFrom ?? \"\") != \"\" ? cal.windowFrom + \"T00:00:00Z\" : n.Add(duration(\"-2160h\")).UTC().Format(\"2006-01-02T15:04:05Z\");\nlet ct = (cal?.windowTo ?? \"\") != \"\" ? cal.windowTo + \"T00:00:00Z\" : n.Add(duration(\"8760h\")).UTC().Format(\"2006-01-02T15:04:05Z\");\n{from: (args?.from ?? \"\") \u003e cf ? args.from : cf, to: (args?.to ?? \"\") != \"\" \u0026\u0026 args.to \u003c ct ? args.to : ct}",
        "type": "json"
      }
    },
    {
      "id": "excQuery",
      "type": "data.expression",
      "title": "Its exceptions",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "expr": "{where: {series: target}, limit: 1000}",
        "type": "json"
      }
    },
    {
      "id": "exceptions",
      "type": "records.query",
      "title": "The series' exceptions",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "entity": "calEvent"
      }
    },
    {
      "id": "occQuery",
      "type": "data.expression",
      "title": "Its occurrences",
      "position": {
        "x": 340,
        "y": 400
      },
      "config": {
        "expr": "{where: {series: target}, limit: 2000}",
        "type": "json"
      }
    },
    {
      "id": "existing",
      "type": "records.query",
      "title": "The occurrences there are",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "entity": "calOccurrence"
      }
    },
    {
      "id": "local",
      "type": "time.convert",
      "title": "The series' start in its zone",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "zone",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 200
      },
      "config": {
        "expr": "(state?.zone ?? \"\") != \"\" ? state.zone : (cal?.zone ?? \"\") != \"\" ? cal.zone : \"UTC\"",
        "type": "string"
      }
    },
    {
      "id": "instant",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 600
      },
      "config": {
        "expr": "(state?.start ?? \"\") != \"\" ? string(state.start) : \"1970-01-01T00:00:00Z\"",
        "type": "string"
      }
    },
    {
      "id": "startZoned",
      "type": "data.expression",
      "title": "The start as a zoned time or date",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "(state?.allDay ?? false) ? {date: string(state.start)[0:10]} : {local: localTime, zone: zone}",
        "type": "json"
      }
    },
    {
      "id": "minutes",
      "type": "data.expression",
      "title": "Its length in minutes",
      "position": {
        "x": 340,
        "y": 800
      },
      "config": {
        "expr": "state == nil ? 0 : int((date(state.end) - date(state.start)).Minutes())",
        "type": "number"
      }
    },
    {
      "id": "rrule",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 1000
      },
      "config": {
        "expr": "state?.rrule ?? \"\"",
        "type": "string"
      }
    },
    {
      "id": "expand",
      "type": "time.expand",
      "title": "The occurrences in the window",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "let m = state;\nlet alive = m != nil \u0026\u0026 m.series == nil \u0026\u0026 (m.status ?? \"confirmed\") != \"cancelled\";\nlet excs = filter(exceptions ?? [], #.series == target);\nlet exRids = map(excs, #.recurrenceId);\nlet fromOcc = alive ? map(filter(expanded ?? [], !(#.recurrenceId in exRids) \u0026\u0026 ((len(#.recurrenceId ?? \"\") == 10 ? #.recurrenceId + \"T00:00:00Z\" : (#.recurrenceId ?? \"\")) \u003e= window.from \u0026\u0026 (len(#.recurrenceId ?? \"\") == 10 ? #.recurrenceId + \"T00:00:00Z\" : (#.recurrenceId ?? \"\")) \u003c window.to)), ({key: #.recurrenceId, event: target, start: #.start, end: #.end, allDay: #.allDay ?? false, status: m.status ?? \"confirmed\", transparency: m.transparency ?? \"opaque\"})) : [];\nlet fromExc = alive ? map(filter(excs, (#.status ?? \"confirmed\") != \"cancelled\" \u0026\u0026 ((len(#.recurrenceId ?? \"\") == 10 ? #.recurrenceId + \"T00:00:00Z\" : (#.recurrenceId ?? \"\")) \u003e= window.from \u0026\u0026 (len(#.recurrenceId ?? \"\") == 10 ? #.recurrenceId + \"T00:00:00Z\" : (#.recurrenceId ?? \"\")) \u003c window.to)), ({key: #.recurrenceId, event: #._id, start: #.start, end: #.end, allDay: #.allDay ?? false, status: #.status ?? \"confirmed\", transparency: #.transparency ?? \"opaque\"})) : [];\nlet want = concat(fromOcc, fromExc);\nlet have = filter(existing ?? [], #.series == target \u0026\u0026 ((len(#.recurrenceId ?? \"\") == 10 ? #.recurrenceId + \"T00:00:00Z\" : (#.recurrenceId ?? \"\")) \u003e= window.from \u0026\u0026 (len(#.recurrenceId ?? \"\") == 10 ? #.recurrenceId + \"T00:00:00Z\" : (#.recurrenceId ?? \"\")) \u003c window.to));\n{problem: \"\",\n creates: map(filter(want, { let d = #; none(have, {.recurrenceId == d.key}) }), ({id: target + \"_\" + replace(replace(replace(#.key, \"-\", \"\"), \":\", \"\"), \"+\", \"\"), values: {event: #.event, series: target, calendar: m.calendar, start: #.start, end: #.end, allDay: #.allDay, recurrenceId: #.key, status: #.status, transparency: #.transparency}})),\n updates: filter(map(have, { let h = #; let d = find(want, {.key == h.recurrenceId}); d == nil || (string(d.event) == string(h.event) \u0026\u0026 d.start == h.start \u0026\u0026 d.end == h.end \u0026\u0026 d.status == (h.status ?? \"confirmed\") \u0026\u0026 d.transparency == (h.transparency ?? \"opaque\")) ? nil : ({id: h._id, set: {event: d.event, start: d.start, end: d.end, allDay: d.allDay, status: d.status, transparency: d.transparency}}) }), # != nil),\n deletes: map(filter(have, { let h = #; none(want, {.key == h.recurrenceId}) }), ({id: #._id}))}",
        "type": "json"
      }
    },
    {
