        "node": "byUid",
        "pin": "records"
      },
      "to": {
        "node": "found",
        "pin": "uid"
      }
    },
    {
      "from": {
        "node": "found",
        "pin": "value"
      },
      "to": {
        "node": "asEvent",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "message"
      },
      "to": {
        "node": "asEvent",
        "pin": "message"
      }
    },
