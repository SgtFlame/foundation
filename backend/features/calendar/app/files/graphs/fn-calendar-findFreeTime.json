        "node": "calIds",
        "pin": "records"
      }
    },
    {
      "from": {
        "node": "calIds",
        "pin": "value"
      },
      "to": {
        "node": "occQuery",
        "pin": "calIds"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "from"
      },
      "to": {
        "node": "occQuery",
        "pin": "from"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "to"
      },
      "to": {
        "node": "occQuery",
        "pin": "to"
      }
    },
    {
      "from": {
        "node": "occQuery",
        "pin": "value"
      },
      "to": {
        "node": "occ",
        "pin": "query"
      }
    },
    {
      "from": {
        "node": "ids",
        "pin": "value"
      },
      "to": {
        "node": "availQuery",
        "pin": "ids"
      }
    },
    {
      "from": {
        "node": "availQuery",
        "pin": "value"
      },
      "to": {
        "node": "avail",
        "pin": "query"
      }
    },
    {
      "from": {
        "node": "ids",
        "pin": "value"
      },
