      },
      "to": {
        "node": "ids",
        "pin": "kind"
      }
    },
    {
      "from": {
        "node": "ids",
        "pin": "value"
      },
      "to": {
        "node": "calQuery",
        "pin": "ids"
      }
    },
    {
      "from": {
        "node": "calQuery",
        "pin": "value"
      },
      "to": {
        "node": "cals",
        "pin": "query"
      }
    },
    {
      "from": {
        "node": "cals",
        "pin": "records"
      },
