{
  "id": "cmd-game-startShip",
  "name": "game.startShip",
  "description": "Decides the start of a ship: its outline from a premade design, placed in a world where a player stands.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.startShip",
    "title": "Start a ship",
    "description": "Starts a ship from a premade design (game.shipDesigns: skiff, prospector, hauler, freighter, barge (V25, at Trade 4), and the cabin, a building only built on the planet with air) at a point in a world, its outline showing every block still to place; the target is the new ship's id, made by the sender. Place its blocks with game.placeBlock, then sit in its cockpit and fly it with game.flyShip. Refused when the ship exists, the world does not, the design is unknown or not yet unlocked for the sender (the hauler needs the cobalt-shipyard contract done) or the point is far from the world's bodies.",
    "args": {
      "type": "object",
      "properties": {
        "world": {
          "type": "string",
          "description": "The world's id"
        },
        "design": {
          "type": "string",
          "description": "The design's id: skiff, prospector, hauler, freighter, barge or cabin"
        },
        "x": {
          "type": "number",
          "description": "Where its block 0 0 0 stands, metres from the moon's centre"
        },
        "y": {
          "type": "number",
          "description": "The point's y in metres"
        },
        "z": {
          "type": "number",
          "description": "The point's z in metres"
        },
        "q": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Its orientation as a quaternion [x, y, z, w]: the design's y up along the ground's up"
        }
      },
      "required": [
        "world",
        "design",
        "x",
        "y",
        "z",
        "q"
      ]
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "started"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "world",
            "type": "string",
            "description": "The world's id"
          },
          {
            "id": "design",
            "type": "string",
            "description": "The design's id"
          },
          {
            "id": "x",
            "type": "number",
            "description": "The point's x in metres"
          },
          {
            "id": "y",
            "type": "number",
            "description": "The point's y in metres"
          },
          {
            "id": "z",
            "type": "number",
            "description": "The point's z in metres"
          },
          {
            "id": "q",
            "type": "json",
            "description": "The orientation quaternion"
          }
        ]
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 0
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the ship",
      "position": {
        "x": 500,
        "y": 0
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "worldKey",
      "type": "data.expression",
      "title": "World key",
      "position": {
        "x": 250,
        "y": 300
      },
      "config": {
        "expr": "\"gameWorld.\" + world",
        "type": "string"
      }
    },
    {
      "id": "w",
      "type": "live.readProjection",
      "title": "Read the world",
      "position": {
        "x": 500,
        "y": 300
      },
      "config": {
        "projector": "game.worlds"
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 250,
        "y": 550
      }
    },
    {
      "id": "playerKey",
      "type": "data.expression",
      "title": "Player key",
      "position": {
        "x": 500,
        "y": 550
      },
      "config": {
        "expr": "world + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "player",
      "type": "live.readProjection",
      "title": "Read the sender's progress",
      "position": {
        "x": 750,
        "y": 550
      },
      "config": {
        "projector": "game.players"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 800,
        "y": 150
      },
      "config": {
        "expr": "taken ? \"there is already a ship \" + target : !found || w?.deleted == true ? \"there is no world \" + world : !(design in [\"skiff\", \"prospector\", \"hauler\", \"freighter\", \"barge\", \"cabin\"]) ? \"there is no ship design \" + design + \"; game.shipDesigns lists them\" : design == \"hauler\" && !(known && (me?.unlocked?.hauler ?? false)) ? \"the shipyard builds a hauler's frame once you have brought it cobalt ore from the asteroids (the cobalt-shipyard contract)\" : design == \"freighter\" && !(known && (me?.unlocked?.freighter ?? false)) ? \"the shipyard builds a freighter's frame for a pilot whose Trade has reached level 3: take jobs from the job board\" : design == \"barge\" && !(known && (me?.unlocked?.barge ?? false)) ? \"the shipyard builds an ore barge's frame for a pilot whose Trade has reached level 4: take jobs from the job board\" : design == \"cabin\" && ((x - 1600) ** 2 + y * y + z * z < 120 ** 2 || (x - 1600) ** 2 + y * y + z * z > 160 ** 2) ? \"a cabin is built on the ground of the planet with air\" : type(q) != \"array\" || len(q) != 4 ? \"q is a quaternion [x, y, z, w]\" : (x * x + y * y + z * z > (w.generator.radius + w.generator.amplitude + 150) ** 2 && (x - 1600) ** 2 + y * y + z * z > 300 ** 2) ? \"the point is too far from the world's moon, asteroids and planet\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1300,
        "y": 0
      }
    },
    {
      "id": "started",
      "type": "data.expression",
      "title": "The ship",
      "position": {
        "x": 1300,
        "y": 350
      },
      "config": {
        "expr": "{world: world, design: design, x: x, y: y, z: z, q: q, blocks: {skiff: 27, prospector: 32, hauler: 58, freighter: 82, barge: 112, cabin: 76}[design]}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1600,
        "y": -100
      },
      "config": {
        "event": "started"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1600,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "start a skiff or a prospector (or a hauler or freighter, once unlocked) near where you stand in an existing world, with a new ship id"
      }
    }
  ],
