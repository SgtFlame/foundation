{
  "id": "cmd-game-fitDrive",
  "name": "game.fitDrive",
  "description": "Decides a jump drive fitted to a ship.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.fitDrive",
    "title": "Fit a jump drive to a ship",
    "description": "Fits a jump drive from the sender's pack to a ship (V27); the target is the ship's id. A ship with a jump drive jumps between the moon and the planet with air from its cockpit, spending half its battery. Refused for a building, the skiff (it has no battery to charge the drive), a ship that already has one, or a pack without a drive.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "driveFitted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 300
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the ship",
      "position": {
        "x": 500,
        "y": 150
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 750,
        "y": 400
      },
      "config": {
        "expr": "(ship?.world ?? \"\") + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 1000,
        "y": 400
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 1300,
        "y": 150
      },
      "config": {
        "expr": "!found ? \"there is no ship \" + target : ship.design == \"cabin\" ? \"a cabin cannot jump\" : ship.design == \"skiff\" ? \"the skiff has no battery to charge a jump drive\" : ship?.jump ?? false ? \"the ship already has a jump drive\" : (pack?.drives ?? 0) < 1 ? \"you have no jump drive: make one at a cabin's fabricator\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1550,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "id": "driveFitted",
      "type": "data.expression",
      "title": "The kit fitted",
      "position": {
        "x": 1800,
        "y": 350
      },
      "config": {
        "expr": "{world: ship.world, pack: {drives: -1}}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 2100,
        "y": -100
      },
      "config": {
        "event": "driveFitted"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 2100,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "make a jump drive at a cabin's fabricator (game.fabricate with item jumpDrive, then game.takeFabricated) and fit it to a powered ship"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "shipKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "shipKey",
        "pin": "value"
      },
      "to": {
        "node": "ship",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "packKey",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "packKey",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "packKey",
        "pin": "value"
      },
      "to": {
        "node": "pack",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "pack",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "pack"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "driveFitted",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "driveFitted",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
