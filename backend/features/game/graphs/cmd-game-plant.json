{
  "id": "cmd-game-plant",
  "name": "game.plant",
  "description": "Decides a crop planted in the soil of the planet with air.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.plant",
    "title": "Plant a crop",
    "description": "Plants barley at a point on the soil of the planet with air (centred 1600 m along x from the moon, 140 m in radius); the target is the world's id. It ripens in 90 s, then game.harvest takes it as food. Refused when the world does not exist, the point is not on the planet's surface, or another crop grows within 1.5 m.",
    "args": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "Where to plant, metres from the moon's centre"
        },
        "y": {
          "type": "number",
          "description": "The point's y in metres"
        },
        "z": {
          "type": "number",
          "description": "The point's z in metres"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "area": "game",
    "targetType": "terrain",
    "projection": "game.crops",
    "action": "game.play",
    "events": [
      "planted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "x",
            "type": "number",
            "description": "The point's x in metres"
          },
          {
            "id": "y",
            "type": "number",
            "description": "The point's y in metres"
          },
          {
            "id": "z",
            "type": "number",
            "description": "The point's z in metres"
          }
        ]
      }
    },
    {
      "id": "worldKey",
      "type": "data.expression",
      "title": "World key",
      "position": {
        "x": 250,
        "y": 0
      },
      "config": {
        "expr": "\"gameWorld.\" + target",
        "type": "string"
      }
    },
    {
      "id": "w",
      "type": "live.readProjection",
      "title": "Read the world",
      "position": {
        "x": 500,
        "y": 0
      },
      "config": {
        "projector": "game.worlds"
      }
    },
    {
      "id": "cropsKey",
      "type": "data.expression",
      "title": "Crops key",
      "position": {
        "x": 250,
        "y": 250
      },
      "config": {
        "expr": "\"terrain.\" + target",
        "type": "string"
      }
    },
    {
      "id": "crops",
      "type": "live.readProjection",
      "title": "Read the crops",
      "position": {
        "x": 500,
        "y": 250
      },
      "config": {
        "projector": "game.crops"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 800,
        "y": 150
      },
      "config": {
        "expr": "let r = ((x - 1600) ** 2 + y * y + z * z) ** 0.5; let crops = state?.crops ?? {}; !found || w?.deleted == true ? \"there is no world \" + target : r \u003c 125 || r \u003e 156 ? \"crops grow only in the soil of the planet with air, on its surface\" : any(values(crops), {(#.x - x) ** 2 + (#.y - y) ** 2 + (#.z - z) ** 2 \u003c 2.25}) ? \"another crop grows within 1.5 m\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1300,
        "y": 0
      }
    },
    {
      "id": "planted",
      "type": "data.expression",
      "title": "Planted",
      "position": {
        "x": 1300,
        "y": 350
      },
      "config": {
        "expr": "{id: \"c\" + string(state?.next ?? 0), x: round(x * 100) / 100, y: round(y * 100) / 100, z: round(z * 100) / 100}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1600,
        "y": -100
      },
      "config": {
        "event": "planted"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1600,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "plant on the planet's soil, away from other crops"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "worldKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "worldKey",
        "pin": "value"
      },
      "to": {
        "node": "w",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "w",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "w"
      }
    },
    {
      "from": {
        "node": "w",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "cropsKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "cropsKey",
        "pin": "value"
      },
      "to": {
        "node": "crops",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "crops",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "state"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "x"
      },
      "to": {
        "node": "check",
        "pin": "x"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "y"
      },
      "to": {
        "node": "check",
        "pin": "y"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "z"
      },
      "to": {
        "node": "check",
        "pin": "z"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "crops",
        "pin": "value"
      },
      "to": {
        "node": "planted",
        "pin": "state"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "x"
      },
      "to": {
        "node": "planted",
        "pin": "x"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "y"
      },
      "to": {
        "node": "planted",
        "pin": "y"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "z"
      },
      "to": {
        "node": "planted",
        "pin": "z"
      }
    },
    {
      "from": {
        "node": "planted",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
