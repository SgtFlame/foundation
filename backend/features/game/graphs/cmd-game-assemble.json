{
  "id": "cmd-game-assemble",
  "name": "game.assemble",
  "description": "Decides finished blocks assembled at the block works from a storage building's components.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.assemble",
    "title": "Assemble finished blocks",
    "description": "Assembles finished blocks at a finished block works (forge 360 V37, design blockworks); the target is the block works' id. The components come from the stock of a finished storage building within 30 m (from), and the finished blocks go back into it as block:<type> (block:armor), to be taken with game.withdraw and placed whole: game.placeBlock takes a finished block of the type in place of its components. Refused for anything but a finished block works, an unknown block, a count outside 1 to 100, no storage near, or a storage short of the components.",
    "args": {
      "type": "object",
      "properties": {
        "block": {
          "type": "string",
          "description": "The block type: armor, cockpit, thruster, gyro, battery, solar, light, cargo, concrete or deck"
        },
        "count": {
          "type": "integer",
          "description": "How many, 1 to 100 (1 when left out)"
        },
        "from": {
          "type": "string",
          "description": "The finished storage building within 30 m whose components are used and which keeps the finished blocks"
        }
      },
      "required": [
        "block",
        "from"
      ]
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "assembled",
      "stored"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "block",
            "type": "string",
            "description": "The block type"
          },
          {
            "id": "count",
            "type": "number",
            "description": "How many"
          },
          {
            "id": "from",
            "type": "string",
            "description": "The storage building"
          }
        ]
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the block works",
      "position": {
        "x": 500,
        "y": 150
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "depKey",
      "type": "data.expression",
      "title": "The storage's key",
      "position": {
        "x": 250,
        "y": 450
      },
      "config": {
        "expr": "\"gameShip.\" + ((from ?? \"\") == \"\" ? \"none\" : from)",
        "type": "string"
      }
    },
    {
      "id": "dep",
      "type": "live.readProjection",
      "title": "Read the storage",
      "position": {
        "x": 500,
        "y": 450
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 900,
        "y": 150
      },
      "config": {
        "expr": "let costs = {armor: {plate: 2}, cockpit: {plate: 3, wire: 2}, thruster: {nozzle: 1, plate: 1, wire: 1}, gyro: {plate: 2, wire: 3}, battery: {cell: 2, wire: 1}, solar: {solarCell: 2, wire: 1}, light: {wire: 1}, cargo: {plate: 4}, concrete: {cement: 2}, deck: {plate: 1}}; let n = howMany ?? 1; let cost = costs[block ?? \"\"] ?? {}; let names = sort(keys(cost)); let have = dep?.stock ?? {}; let short = filter(names, (have[#] ?? 0) < cost[#] * n); !found ? \"there is no block works \" + target : ship.design != \"blockworks\" ? \"only the block works assembles blocks\" : len(ship.placed) < ship.blocks ? \"the block works is not finished: place its last \" + string(ship.blocks - len(ship.placed)) + \" blocks first\" : !(block in costs) ? \"the block works assembles \" + join(sort(keys(costs)), \", \") + \" blocks\" : type(n) != \"int\" && int(n) != n || n < 1 || n > 100 ? \"count is a whole number from 1 to 100\" : !(hasDep && dep?.design == \"depot\" && len(dep?.placed ?? []) >= (dep?.blocks ?? 1) && (ship.x - dep.x) ** 2 + (ship.y - dep.y) ** 2 + (ship.z - dep.z) ** 2 <= 30 ** 2) ? \"from names a finished storage building within 30 m that holds the components\" : len(short) > 0 ? string(int(n)) + \" \" + block + \" blocks take \" + join(map(names, string(int(cost[#] * n)) + \" \" + #), \", \") + \"; the storage is short of \" + join(short, \", \") : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "position": {
        "x": 1150,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1400,
        "y": 0
      }
    },
    {
      "id": "made",
      "type": "data.expression",
      "title": "What was assembled",
      "position": {
        "x": 1400,
        "y": 300
      },
      "config": {
        "expr": "{world: ship.world, block: block, count: int(howMany ?? 1)}",
        "type": "json"
      }
    },
    {
      "id": "depTake",
      "type": "data.expression",
      "title": "The storage's change",
      "position": {
        "x": 1400,
        "y": 500
      },
      "config": {
        "expr": "let costs = {armor: {plate: 2}, cockpit: {plate: 3, wire: 2}, thruster: {nozzle: 1, plate: 1, wire: 1}, gyro: {plate: 2, wire: 3}, battery: {cell: 2, wire: 1}, solar: {solarCell: 2, wire: 1}, light: {wire: 1}, cargo: {plate: 4}, concrete: {cement: 2}, deck: {plate: 1}}; let n = int(howMany ?? 1); let cost = costs[block]; {world: ship.world, stock: fromPairs(concat(map(keys(cost), [#, -cost[#] * n]), [[\"block:\" + block, n]]))}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1700,
        "y": -100
      },
      "config": {
        "event": "assembled"
      }
    },
    {
      "id": "emitDep",
      "type": "live.emit",
      "title": "Change the storage",
      "position": {
        "x": 2000,
        "y": -100
      },
      "config": {
        "event": "stored",
        "projection": "game.ships"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1700,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "finish the block works, put the components in a storage building within 30 m (game.store), and name it as from"
      }
    }
  ],
  "edges": [
