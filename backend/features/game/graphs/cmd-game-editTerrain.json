{
  "id": "cmd-game-editTerrain",
  "name": "game.editTerrain",
  "description": "Decides a dig or fill of a world's terrain: checks the brush against the world and emits the edit.",
  "kind": "command",
  "version": 1,
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "kind",
            "type": "string",
            "description": "dig or fill"
          },
          {
            "id": "x",
            "type": "number",
            "description": "The brush centre's x in metres"
          },
          {
            "id": "y",
            "type": "number",
            "description": "The brush centre's y in metres"
          },
          {
            "id": "z",
            "type": "number",
            "description": "The brush centre's z in metres"
          },
          {
            "id": "radius",
            "type": "number",
            "description": "The brush radius in metres"
          }
        ]
      }
    },
    {
      "id": "key",
      "type": "data.expression",
      "position": {
        "x": 250,
        "y": 250
      },
      "config": {
        "expr": "\"gameWorld.\" + target",
        "type": "string"
      },
      "title": "World key"
    },
    {
      "id": "world",
      "type": "live.readProjection",
      "position": {
        "x": 500,
        "y": 250
      },
      "config": {
        "projector": "game.worlds"
      },
      "title": "Read the world"
    },
    {
      "id": "check",
      "type": "data.expression",
      "position": {
        "x": 750,
        "y": 250
      },
      "config": {
        "expr": "!exists || world?.deleted == true ? \"there is no world \" + target : !(kind in [\"dig\", \"fill\"]) ? \"an edit is dig or fill\" : radius < 0.5 || radius > 6 ? \"an edit's radius is from 0.5 to 6 metres\" : x * x + y * y + z * z > (world.generator.radius * 1.5 + 50) ** 2 ? \"the edit is too far from the world's moon\" : \"\"",
        "type": "string"
      },
      "title": "Why it is refused"
    },
    {
      "id": "ok",
      "type": "data.expression",
      "position": {
        "x": 1000,
        "y": 250
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      },
      "title": "Allowed?"
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1250,
        "y": 0
      }
    },
    {
      "id": "edit",
      "type": "data.expression",
      "position": {
        "x": 1250,
        "y": 400
      },
      "config": {
        "expr": "{kind: kind, x: x, y: y, z: z, radius: radius, material: kind == \"fill\" ? 0 : nil}",
        "type": "json"
      },
      "title": "The edit"
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1550,
        "y": -100
      },
      "config": {
        "event": "edited"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1550,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "dig or fill within 6 m brushes on the world's moon"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "key",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "key",
        "pin": "value"
      },
      "to": {
        "node": "world",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "world",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "world"
      }
    },
    {
      "from": {
        "node": "world",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "exists"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "kind"
      },
      "to": {
        "node": "check",
        "pin": "kind"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "kind"
      },
      "to": {
        "node": "edit",
        "pin": "kind"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "x"
      },
      "to": {
        "node": "check",
        "pin": "x"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "x"
      },
      "to": {
        "node": "edit",
        "pin": "x"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "y"
      },
      "to": {
        "node": "check",
        "pin": "y"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "y"
      },
      "to": {
        "node": "edit",
        "pin": "y"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "z"
      },
      "to": {
        "node": "check",
        "pin": "z"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "z"
      },
      "to": {
        "node": "edit",
        "pin": "z"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "radius"
      },
      "to": {
        "node": "check",
        "pin": "radius"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "radius"
      },
      "to": {
        "node": "edit",
        "pin": "radius"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "edit",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ],
  "spec": {
    "command": "game.editTerrain",
    "title": "Dig or fill terrain",
    "description": "Digs (removes) or fills (adds) a smooth sphere of a world's terrain; the target is the world's id. Everyone viewing the world sees the edit, in the server's order. Refused when the world does not exist, the radius is outside 0.5 to 6 m, or the brush is far from the moon.",
    "args": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "dig",
            "fill"
          ],
          "description": "dig removes ground, fill adds it"
        },
        "x": {
          "type": "number",
          "description": "The brush centre in metres, from the moon's centre"
        },
        "y": {
          "type": "number",
          "description": "The brush centre's y in metres"
        },
        "z": {
          "type": "number",
          "description": "The brush centre's z in metres"
        },
        "radius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 6,
          "description": "The brush radius in metres"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "z",
        "radius"
      ]
    },
    "area": "game",
    "targetType": "terrain",
    "projection": "game.terrain",
    "action": "game.play",
    "events": [
      "edited"
    ]
  }
}
