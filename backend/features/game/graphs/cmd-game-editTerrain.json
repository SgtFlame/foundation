{
  "id": "cmd-game-editTerrain",
  "name": "game.editTerrain",
  "description": "Decides a dig or fill of a world's terrain: checks the brush against the world and emits the edit.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.editTerrain",
    "title": "Dig or fill terrain",
    "description": "Digs (removes) or fills (adds) a smooth sphere of a world's terrain; the target is the world's id. Everyone viewing the world sees the edit, in the server's order. A player walking the world sends took (what a dig takes into their pack) or needs (what a fill spends from it); the pack holds 4 m³, and a fill spends dust and rock, never ore. Refused when the world does not exist, the radius is outside 0.5 to 6 m, the brush is far from the world's bodies, a dig would overfill the pack or a fill needs more than it holds. V29: took.minerals {ferrite, silica, ice, malachite, wolframite, spodumene} (m³ each) goes into the pack as minerals, within the sphere and the pack's room.",
    "args": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "dig",
            "fill"
          ],
          "description": "dig removes ground, fill adds it"
        },
        "x": {
          "type": "number",
          "description": "The brush centre in metres, from the moon's centre"
        },
        "y": {
          "type": "number",
          "description": "The brush centre's y in metres"
        },
        "z": {
          "type": "number",
          "description": "The brush centre's z in metres"
        },
        "radius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 6,
          "description": "The brush radius in metres"
        },
        "took": {
          "type": "object",
          "description": "Playing: the ground a dig takes into the sender's pack, in m³ by material (bounded by the brush's volume)",
          "properties": {
            "dust": {
              "type": "number",
              "minimum": 0,
              "description": "Cubic metres of dust"
            },
            "rock": {
              "type": "number",
              "minimum": 0,
              "description": "Cubic metres of rock"
            },
            "ore": {
              "type": "number",
              "minimum": 0,
              "description": "Cubic metres of ore, found in the asteroids (V8)"
            }
          }
        },
        "needs": {
          "type": "number",
          "minimum": 0,
          "description": "Playing: the cubic metres a fill spends from the sender's pack (bounded by the brush's volume)"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "z",
        "radius"
      ]
    },
    "area": "game",
    "targetType": "terrain",
    "projection": "game.terrain",
    "action": "game.play",
    "events": [
      "edited"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "kind",
            "type": "string",
            "description": "dig or fill"
          },
          {
            "id": "x",
            "type": "number",
            "description": "The brush centre's x in metres"
          },
          {
            "id": "y",
            "type": "number",
            "description": "The brush centre's y in metres"
          },
          {
            "id": "z",
            "type": "number",
            "description": "The brush centre's z in metres"
          },
          {
            "id": "radius",
            "type": "number",
            "description": "The brush radius in metres"
          },
          {
            "id": "took",
            "type": "json",
            "description": "What a dig takes into the pack, {dust, rock, ore} in m³, when playing"
          },
          {
            "id": "needs",
            "type": "number",
            "description": "What a fill spends from the pack in m³, when playing"
          }
        ]
      }
    },
    {
      "id": "key",
      "type": "data.expression",
      "title": "World key",
      "position": {
        "x": 250,
        "y": 250
      },
      "config": {
        "expr": "\"gameWorld.\" + target",
        "type": "string"
      }
    },
    {
      "id": "world",
      "type": "live.readProjection",
      "title": "Read the world",
      "position": {
        "x": 500,
        "y": 250
      },
      "config": {
        "projector": "game.worlds"
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 550
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 250,
        "y": 550
      },
      "config": {
        "expr": "target + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 500,
        "y": 550
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "amounts",
      "type": "data.expression",
      "title": "What the pack takes or spends",
      "position": {
        "x": 750,
        "y": 550
      },
      "config": {
        "expr": "let V = 4.18879 * radius ** 3; let have = packed ? pack : {dust: 0, rock: 0, ore: 0}; let ho = have?.ore ?? 0; let playing = took != nil || needs != nil; let td = kind == \"dig\" && took != nil ? min(max(took?.dust ?? 0, 0), V) : 0; let tr = kind == \"dig\" && took != nil ? min(max(took?.rock ?? 0, 0), V - td) : 0; let tore = kind == \"dig\" && took != nil ? min(max(took?.ore ?? 0, 0), V - td - tr) : 0; let names = [\"ferrite\", \"silica\", \"ice\", \"malachite\", \"wolframite\", \"spodumene\", \"limestone\", \"coal\"]; let tm = kind == \"dig\" && took?.minerals != nil ? took.minerals : {}; let left = V - td - tr - tore; let mins = fromPairs(map(filter(names, (tm[#] ?? 0) > 0), [#, round(min(max(tm[#], 0), left) * 1000) / 1000])); let tmin = sum(values(mins)); let hm = sum(values(have?.minerals ?? {})); let n = kind == \"fill\" && needs != nil ? min(max(needs, 0), V) : 0; let sd = min(have.dust, n); let sr = max(n - sd, 0); {room: 4 - have.dust - have.rock - ho - (have?.iron ?? 0) - hm, take: td + tr + tore + tmin, have: have.dust + have.rock, need: n, delta: len(mins) > 0 ? {dust: td - sd, rock: tr - sr, ore: tore, minerals: mins} : {dust: td - sd, rock: tr - sr, ore: tore}, mineral: tmin, material: sr > sd ? 1 : 0}",
        "type": "json"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 750,
        "y": 250
      },
      "config": {
        "expr": "!exists || world?.deleted == true ? \"there is no world \" + target : !(kind in [\"dig\", \"fill\"]) ? \"an edit is dig or fill\" : radius < 0.5 || radius > 6 ? \"an edit's radius is from 0.5 to 6 metres\" : (x * x + y * y + z * z > (world.generator.radius + world.generator.amplitude + 150) ** 2 && (x - 1600) ** 2 + y * y + z * z > 300 ** 2) ? \"the edit is too far from the world's moon, asteroids and planet\" : amounts.take > amounts.room + 0.001 ? \"your pack is full: it has room for \" + string(round(max(amounts.room, 0) * 100) / 100) + \" m³ and this dig takes \" + string(round(amounts.take * 100) / 100) + \" m³; fill somewhere to empty it\" : amounts.need > amounts.have + 0.001 ? \"your pack holds \" + string(round(amounts.have * 100) / 100) + \" m³ and this fill needs \" + string(round(amounts.need * 100) / 100) + \" m³; dig to fill it\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1000,
        "y": 250
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1250,
        "y": 0
      }
    },
    {
      "id": "edit",
      "type": "data.expression",
      "title": "The edit",
      "position": {
        "x": 1250,
        "y": 400
      },
      "config": {
        "expr": "{kind: kind, x: x, y: y, z: z, radius: radius, material: kind == \"fill\" ? amounts.material : nil, pack: amounts.delta.dust == 0 && amounts.delta.rock == 0 && amounts.delta.ore == 0 && amounts.mineral == 0 ? nil : amounts.delta}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1550,
        "y": -100
      },
      "config": {
        "event": "edited"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1550,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "dig or fill within 6 m brushes on the world's bodies; empty a full pack by filling, fill a short one by digging"
      }
    }
  ],
