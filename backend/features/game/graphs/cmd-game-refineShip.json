{
  "id": "cmd-game-refineShip",
  "name": "game.refineShip",
  "description": "Decides one run of a ship's refinery: rock from its hold into iron, paid in charge.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.refineShip",
    "title": "Refine aboard a ship",
    "description": "Runs a ship's refinery once: up to 1 m³ of rock from its hold becomes half as much iron, drawing a tenth of the battery; the target is the ship's id. Refused when the ship does not exist, has no refinery placed, someone is flying it, its battery holds less than a tenth or its hold has no rock.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "refined"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 0
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the ship",
      "position": {
        "x": 500,
        "y": 0
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 800,
        "y": 150
      },
      "config": {
        "expr": "let refineries = {skiff: [], prospector: [29]}; let mine = found ? (refineries[ship.design] ?? []) : []; !found ? \"there is no ship \" + target : len(filter(mine, # in ship.placed)) == 0 ? \"this ship has no refinery placed\" : ship.pilot != \"\" ? \"land and leave the seat before refining\" : (ship.charge ?? 0) \u003c 0.1 ? \"the battery is too low to run the refinery\" : (ship.cargo?.rock ?? 0) \u003c= 0.0001 ? \"there is no rock in the hold to refine\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1300,
        "y": 0
      }
    },
    {
      "id": "refined",
      "type": "data.expression",
      "title": "What it makes",
      "position": {
        "x": 1300,
        "y": 350
      },
      "config": {
        "expr": "let r = min(ship.cargo.rock, 1); {world: ship.world, rock: -r, iron: r / 2, charge: -0.1}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1600,
        "y": -100
      },
      "config": {
        "event": "refined"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1600,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "place the refinery, land, charge the battery and load rock first"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "shipKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "shipKey",
        "pin": "value"
      },
      "to": {
        "node": "ship",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "refined",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "refined",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
