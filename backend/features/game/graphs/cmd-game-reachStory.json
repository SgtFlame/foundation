{
  "id": "cmd-game-reachStory",
  "name": "game.reachStory",
  "description": "Decides a step of a story reached, or where the player is in it, saved so they come back there.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.reachStory",
    "title": "Save my place in the story",
    "description": "Saves the sender's place in a story: the target is the story's starting area (the farmstead of the first hour), step the step just reached (empty to save only where they are), area the area they are in and x, z where they stand in it. game.story gives it back, so Play the first hour resumes there. item and spot record a herb gathered (S7). Refused for an unknown step or item, or an area that does not exist.",
    "args": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "description": "The step just reached: arrive, farmer, howl, signature, trail, fight, road, rest, morning, forage or herbal; empty to save only the place"
        },
        "item": {
          "type": "string",
          "description": "S7: a herb just gathered (thyme, nettle or yarrow), with spot; empty for none"
        },
        "spot": {
          "type": "string",
          "description": "S7: where the item was gathered, so each spot gives it once"
        },
        "area": {
          "type": "string",
          "description": "The id of the area the player is in"
        },
        "x": {
          "type": "number",
          "description": "Where they stand in that area, metres east of its corner"
        },
        "z": {
          "type": "number",
          "description": "Where they stand, metres south of its corner"
        }
      },
      "required": [
        "area",
        "x",
        "z"
      ]
    },
    "area": "game",
    "targetType": "story",
    "projection": "game.storyLog",
    "action": "game.play",
    "events": [
      "reached"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "step",
            "type": "string",
            "description": "The step just reached, or empty"
          },
          {
            "id": "item",
            "type": "string",
            "description": "A herb gathered, or empty"
          },
          {
            "id": "spot",
            "type": "string",
            "description": "Where it was gathered"
          },
          {
            "id": "area",
            "type": "string",
            "description": "The area the player is in"
          },
          {
            "id": "x",
            "type": "number",
            "description": "Metres east of the area's corner"
          },
          {
            "id": "z",
            "type": "number",
            "description": "Metres south of the area's corner"
          }
        ]
      }
    },
    {
      "id": "startKey",
      "type": "data.expression",
      "title": "Story's area key",
      "position": {
        "x": 250,
        "y": 0
      },
      "config": {
        "expr": "\"gameArea.\" + target",
        "type": "string"
      }
    },
    {
      "id": "start",
      "type": "live.readProjection",
      "title": "Read the story's area",
      "position": {
        "x": 500,
        "y": 0
      },
      "config": {
        "projector": "game.areas"
      }
    },
    {
      "id": "hereKey",
      "type": "data.expression",
      "title": "Area key",
      "position": {
        "x": 250,
        "y": 250
      },
      "config": {
        "expr": "\"gameArea.\" + area",
        "type": "string"
      }
    },
    {
      "id": "here",
      "type": "live.readProjection",
      "title": "Read the area",
      "position": {
        "x": 500,
        "y": 250
      },
      "config": {
        "projector": "game.areas"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 800,
        "y": 150
      },
      "config": {
        "expr": "!started || start?.deleted == true ? \"there is no area \" + target + \" to start a story in\" : (step ?? \"\") not in [\"\", \"arrive\", \"farmer\", \"howl\", \"signature\", \"trail\", \"fight\", \"road\", \"rest\", \"morning\", \"forage\", \"herbal\"] ? \"there is no step \" + step + \" in the story\" : (item ?? \"\") not in [\"\", \"thyme\", \"nettle\", \"yarrow\"] ? \"there is no herb \" + item + \" to gather\" : !found || here?.deleted == true ? \"there is no area \" + area : x \u003c 0 || z \u003c 0 || x \u003e here.width * 10 + 1 || z \u003e here.depth * 10 + 1 ? \"the point is outside \" + here.name : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1300,
        "y": 0
      }
    },
    {
      "id": "reached",
      "type": "data.expression",
      "title": "Reached",
      "position": {
        "x": 1300,
        "y": 350
      },
      "config": {
        "expr": "{step: step ?? \"\", item: item ?? \"\", spot: spot ?? \"\", area: area, x: round(x * 100) / 100, z: round(z * 100) / 100}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1600,
        "y": -100
      },
      "config": {
        "event": "reached"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1600,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "send a step of the first hour and a point in an existing area"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "startKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "startKey",
        "pin": "value"
      },
      "to": {
        "node": "start",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "start",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "start"
      }
    },
    {
      "from": {
        "node": "start",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "started"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "area"
