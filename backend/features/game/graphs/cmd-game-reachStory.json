      }
    },
    {
      "from": {
        "node": "here",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "here"
      }
    },
    {
      "from": {
        "node": "here",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "step"
      },
      "to": {
        "node": "check",
        "pin": "step"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "item"
      },
      "to": {
        "node": "check",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "area"
      },
      "to": {
        "node": "check",
        "pin": "area"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "x"
      },
      "to": {
        "node": "check",
        "pin": "x"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "z"
      },
      "to": {
        "node": "check",
        "pin": "z"
      }
    },
    {
      "from": {
