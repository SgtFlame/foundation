{
  "id": "cmd-game-salvage",
  "name": "game.salvage",
  "description": "Decides a block torn off one of the moon's wrecks for scrap.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.salvage",
    "title": "Salvage a wreck",
    "description": "Tears one block off a derelict skiff on the moon (V15); the target is the world's id. wreck is k0 or k1 and index the block (0 to 26, the skiff's); the scrap goes into the sender's pack as 0.25 m³ of ore, and the block is gone for everyone (game.wrecks). Refused away from the moon, for an unknown wreck or block, one already salvaged, or a full pack. Block 13 of each wreck holds a manual (V18): its salvager gets manual powerDrill (game.player's manuals), which teaches a cabin's bench the powered drill.",
    "args": {
      "type": "object",
      "properties": {
        "wreck": {
          "type": "string",
          "description": "The wreck: k0 or k1"
        },
        "index": {
          "type": "integer",
          "description": "The block, 0 to 26"
        },
        "x": {
          "type": "number",
          "description": "Where the player stands, metres from the moon's centre"
        },
        "y": {
          "type": "number",
          "description": "The point's y in metres"
        },
        "z": {
          "type": "number",
          "description": "The point's z in metres"
        }
      },
      "required": [
        "wreck",
        "index",
        "x",
        "y",
        "z"
      ]
    },
    "area": "game",
    "targetType": "terrain",
    "projection": "game.wrecks",
    "action": "game.play",
    "events": [
      "salvaged"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "wreck",
            "type": "string",
            "description": "The wreck"
          },
          {
            "id": "index",
            "type": "number",
            "description": "The block"
          },
          {
            "id": "x",
            "type": "number",
            "description": "The point's x in metres"
          },
          {
            "id": "y",
            "type": "number",
            "description": "The point's y in metres"
          },
          {
            "id": "z",
            "type": "number",
            "description": "The point's z in metres"
          }
        ]
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 450
      }
    },
    {
      "id": "wreckKey",
      "type": "data.expression",
      "title": "Wrecks key",
      "position": {
        "x": 250,
        "y": 0
      },
      "config": {
        "expr": "\"terrain.\" + target",
        "type": "string"
      }
    },
    {
      "id": "wrecks",
      "type": "live.readProjection",
      "title": "Read the wrecks salvaged",
      "position": {
        "x": 500,
        "y": 0
      },
      "config": {
        "projector": "game.wrecks"
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 250,
        "y": 300
      },
      "config": {
        "expr": "target + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 500,
        "y": 300
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 800,
        "y": 150
      },
      "config": {
        "expr": "let r = (x ** 2 + y ** 2 + z ** 2) ** 0.5; let k = wreck + \".\" + string(int(index)); let held = (pack?.dust ?? 0) + (pack?.rock ?? 0) + (pack?.ore ?? 0) + (pack?.iron ?? 0); r \u003e 130 ? \"the wrecks lie on the moon\" : !(wreck in [\"k0\", \"k1\"]) ? \"there is no wreck \" + wreck : index \u003c 0 || index \u003e 26 || index != int(index) ? \"a wreck's blocks are 0 to 26\" : (state?.salvaged ?? {})[k] ?? false ? \"that block was salvaged already\" : held + 0.25 \u003e 4 ? \"your pack is full: load it into a ship's hold\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1300,
        "y": 0
      }
    },
    {
      "id": "salvaged",
      "type": "data.expression",
      "title": "Salvaged",
      "position": {
        "x": 1300,
        "y": 350
      },
      "config": {
        "expr": "{wreck: wreck, index: int(index), pack: {ore: 0.25}, manual: int(index) == 13 ? \"powerDrill\" : \"\"}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1600,
        "y": -100
      },
      "config": {
        "event": "salvaged"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1600,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "stand by a wreck on the moon and salvage a block that is still there, with room in your pack"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "wreckKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "wreckKey",
        "pin": "value"
      },
      "to": {
        "node": "wrecks",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "packKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "packKey",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "packKey",
        "pin": "value"
      },
      "to": {
