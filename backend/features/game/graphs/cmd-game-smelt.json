{
  "id": "cmd-game-smelt",
  "name": "game.smelt",
  "description": "Decides ore put into a cabin's forge to smelt.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.smelt",
    "title": "Smelt ore at a forge",
    "description": "Puts ore from the sender's pack into the forge of a cabin (V20); the target is the cabin's id. Up to 2 m³ goes in, and it smelts at 45 s a m³ (the ship's forge gives {ore, at}); game.takeIngots then takes the iron, 0.8 m³ for each m³ of ore. Refused for a ship that is not a cabin, a cabin whose forge is not placed, a forge already holding ore, or a pack without ore.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "smelting"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 300
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the cabin",
      "position": {
        "x": 500,
        "y": 150
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 750,
        "y": 400
      },
      "config": {
        "expr": "(ship?.world ?? \"\") + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 1000,
        "y": 400
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 1300,
        "y": 150
      },
      "config": {
        "expr": "!found ? \"there is no cabin \" + target : ship.design != \"cabin\" ? \"only a cabin has a forge\" : !(75 in ship.placed) ? \"the cabin's forge is not built yet\" : ship?.forge != nil ? \"the forge is already smelting: take its iron first\" : (pack?.ore ?? 0) \u003c= 0.001 ? \"your pack holds no ore to smelt\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1550,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "id": "smelting",
      "type": "data.expression",
      "title": "Smelting",
      "position": {
        "x": 1800,
        "y": 350
      },
      "config": {
        "expr": "let n = min(pack.ore, 2); {world: ship.world, ore: n, at: now().UnixMilli(), pack: {ore: -n}}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 2100,
        "y": -100
      },
      "config": {
        "event": "smelting"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 2100,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "build the forge (block 75) with game.placeBlock, take any iron waiting in it with game.takeIngots, and bring ore from the asteroids or the wrecks"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "shipKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "shipKey",
        "pin": "value"
      },
      "to": {
        "node": "ship",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "packKey",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "packKey",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "packKey",
        "pin": "value"
      },
      "to": {
        "node": "pack",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "pack",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "pack"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "smelting",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "pack",
        "pin": "value"
      },
      "to": {
        "node": "smelting",
        "pin": "pack"
      }
    },
    {
      "from": {
        "node": "smelting",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
