{
  "id": "cmd-game-smelt",
  "name": "game.smelt",
  "description": "Decides ore put into a cabin's forge to smelt.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.smelt",
    "title": "Smelt ore at a forge",
    "description": "Puts ore from the sender's pack into the forge of a cabin (V20); the target is the cabin's id. Up to 2 m³ goes in, and it smelts at 45 s a m³ (the ship's forge gives {ore, at, kind}); game.takeIngots then takes the iron, 0.8 m³ for each m³ of ore. V30: what may instead name a mineral, refined at 60 s a m³ into components (8 steel plates a m³ of ferrite, 10 copper wire of malachite, 4 solar cells of silica, 3 tungsten nozzles of wolframite, 4 battery cells of spodumene), or rock, 6 bags of cement a m³ at 30 s a m³. Refused for a ship that is not a cabin, a cabin whose forge is not placed, a forge already holding a load, an unknown what, or a pack without it.",
    "args": {
      "type": "object",
      "properties": {
        "what": {
          "type": "string",
          "description": "What to put in (V30): ore (the default, smelted into iron), a mineral to refine into components (ferrite into plates, malachite into wire, silica into solar cells, wolframite into nozzles, spodumene into battery cells) or rock (into cement)"
        }
      }
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "smelting"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "what",
            "type": "string",
            "description": "What to put in: ore (the default), a mineral or rock"
          }
        ]
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 300
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the cabin",
      "position": {
        "x": 500,
        "y": 150
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 750,
        "y": 400
      },
      "config": {
        "expr": "(ship?.world ?? \"\") + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 1000,
        "y": 400
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 1300,
        "y": 150
      },
      "config": {
        "expr": "let w = (what ?? \"\") == \"\" ? \"ore\" : what; let have = w == \"ore\" ? (pack?.ore ?? 0) : w == \"rock\" ? (pack?.rock ?? 0) : ((pack?.minerals ?? {})[w] ?? 0); !found ? \"there is no cabin \" + target : ship.design != \"cabin\" ? \"only a cabin has a forge\" : !(75 in ship.placed) ? \"the cabin's forge is not built yet\" : ship?.forge != nil ? \"the forge is already working: take what is in it first\" : w != \"ore\" && !(w in {ferrite: 1, malachite: 1, silica: 1, wolframite: 1, spodumene: 1, rock: 1}) ? \"the forge cannot refine \" + w + \": it takes ore, ferrite, malachite, silica, wolframite, spodumene or rock\" : have <= 0.001 ? \"your pack holds no \" + w + \" to put in\" : w != \"ore\" && min(have, 2) * {ferrite: 8, malachite: 10, silica: 4, wolframite: 3, spodumene: 4, rock: 6}[w] < 0.999999 ? \"too little \" + w + \" to make even one component: dig more\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1550,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "id": "smelting",
      "type": "data.expression",
      "title": "Smelting",
      "position": {
        "x": 1800,
        "y": 350
      },
      "config": {
        "expr": "let w = (what ?? \"\") == \"\" ? \"ore\" : what; let have = w == \"ore\" ? pack.ore : w == \"rock\" ? pack.rock : ((pack?.minerals ?? {})[w] ?? 0); let n = round(min(have, 2) * 1000) / 1000; let taken = w == \"ore\" ? {ore: -n} : w == \"rock\" ? {rock: -n} : {minerals: fromPairs([[w, -n]])}; w == \"ore\" ? {world: ship.world, ore: n, at: now().UnixMilli(), pack: taken} : {world: ship.world, ore: n, at: now().UnixMilli(), kind: w, pack: taken}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 2100,
        "y": -100
      },
      "config": {
        "event": "smelting"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 2100,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "build the forge (block 75) with game.placeBlock, take what is waiting in it with game.takeIngots, and bring ore from the asteroids, minerals from the moon and asteroids, or rock"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "shipKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "shipKey",
        "pin": "value"
      },
      "to": {
        "node": "ship",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "packKey",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "packKey",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "packKey",
        "pin": "value"
      },
      "to": {
        "node": "pack",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "pack",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "pack"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "smelting",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "pack",
        "pin": "value"
      },
      "to": {
        "node": "smelting",
        "pin": "pack"
      }
    },
    {
      "from": {
        "node": "smelting",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "what"
      },
      "to": {
        "node": "check",
        "pin": "what"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "what"
      },
      "to": {
        "node": "smelting",
        "pin": "what"
      }
    }
  ]
}
