{
  "id": "cmd-game-takeIngots",
  "name": "game.takeIngots",
  "description": "Decides the iron taken from a cabin's forge.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.takeIngots",
    "title": "Take iron from a forge",
    "description": "Takes what a cabin's forge has made into the sender's pack (V20); the target is the cabin's id. The forge gives 0.8 m³ of iron for each m³ of ore once its time is up (45 s a m³ since game.smelt), and is empty again. V30: a load of a mineral or rock gives its components instead (parts: plates, wire, solarCell, nozzle, cell or cement, counts that take no room) once 60 s a m³ (30 s for rock) are up. Refused for a ship that is not a cabin, a forge with nothing in it or still working, or a pack without room for iron.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "ingots"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 300
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the cabin",
      "position": {
        "x": 500,
        "y": 150
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 750,
        "y": 400
      },
      "config": {
        "expr": "(ship?.world ?? \"\") + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 1000,
        "y": 400
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 1300,
        "y": 150
      },
      "config": {
        "expr": "let f = ship?.forge; let r = {ferrite: [\"plate\", 8, 60000], malachite: [\"wire\", 10, 60000], silica: [\"solarCell\", 4, 60000], wolframite: [\"nozzle\", 3, 60000], spodumene: [\"cell\", 4, 60000], rock: [\"cement\", 6, 30000]}; let k = f?.kind ?? \"\"; let ms = k == \"\" ? 45000 : r[k][2]; let left = f == nil ? 0 : f.ore * ms - (now().UnixMilli() - f.at); let held = (pack?.dust ?? 0) + (pack?.rock ?? 0) + (pack?.ore ?? 0) + (pack?.iron ?? 0) + sum(values(pack?.minerals ?? {})); !found ? \"there is no cabin \" + target : ship.design != \"cabin\" ? \"only a cabin has a forge\" : f == nil ? \"the forge is empty: put ore, a mineral or rock in with game.smelt\" : left > 0 ? \"the forge is still smelting: \" + string(int(ceil(left / 1000))) + \" s left\" : k == \"\" && held + f.ore * 0.8 > 4.0001 ? \"your pack has no room for the iron\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1550,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "id": "ingots",
      "type": "data.expression",
      "title": "Ingots",
      "position": {
        "x": 1800,
        "y": 350
      },
      "config": {
        "expr": "let r = {ferrite: [\"plate\", 8, 60000], malachite: [\"wire\", 10, 60000], silica: [\"solarCell\", 4, 60000], wolframite: [\"nozzle\", 3, 60000], spodumene: [\"cell\", 4, 60000], rock: [\"cement\", 6, 30000]}; let k = ship.forge?.kind ?? \"\"; let iron = k == \"\" ? round(ship.forge.ore * 0.8 * 1000) / 1000 : 0; let n = k == \"\" ? 0 : int(floor(ship.forge.ore * r[k][1] + 0.000001)); k == \"\" ? {world: ship.world, iron: iron, pack: {iron: iron}} : {world: ship.world, iron: 0, parts: fromPairs([[r[k][0], n]]), pack: {parts: fromPairs([[r[k][0], n]])}}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 2100,
        "y": -100
      },
      "config": {
        "event": "ingots"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 2100,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "put ore, a mineral or rock in the forge with game.smelt, wait until it is done, and make room in your pack for iron"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
