{
  "id": "cmd-game-eat",
  "name": "game.eat",
  "description": "Decides a ration eaten from the sender's pack.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.eat",
    "title": "Eat a ration",
    "description": "Eats one ration of food from the sender's pack in a world (the body's hunger, V10); the target is the world's id. Refused when the pack holds no food.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "game",
    "targetType": "terrain",
    "projection": "game.terrain",
    "action": "game.play",
    "events": [
      "ate"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 300
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "expr": "target + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 500,
        "y": 150
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 800,
        "y": 150
      },
      "config": {
        "expr": "(pack?.food ?? 0) \u003c 1 ? \"there is no food in your pack: harvest a crop on the planet first\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1300,
        "y": 0
      }
    },
    {
      "id": "ate",
      "type": "data.expression",
      "title": "Ate",
      "position": {
        "x": 1300,
        "y": 350
      },
      "config": {
        "expr": "{pack: {food: -1}}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1600,
        "y": -100
      },
      "config": {
        "event": "ate"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1600,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "harvest a ripe crop with game.harvest before eating"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "packKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "packKey",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "packKey",
        "pin": "value"
      },
      "to": {
        "node": "pack",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "pack",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "pack"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ate",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
