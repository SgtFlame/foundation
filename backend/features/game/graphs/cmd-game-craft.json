{
  "id": "cmd-game-craft",
  "name": "game.craft",
  "description": "Decides a tool crafted at a cabin's field bench from the sender's pack.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.craft",
    "title": "Craft at a bench",
    "description": "Crafts a tool at the field bench of a cabin (V14); the target is the cabin's id. Its recipes are drill (a hand drill: 2 m³ of ore and 1 m³ of rock from the sender's pack), which digs wider and faster than bare hands, and turret (V17, a sentry turret: 2 m³ of ore and 1.5 m³ of rock), set down on the moon with game.placeTurret, and powerDrill (V18, a powered drill: 2.5 m³ of ore and 1 m³ of rock, for a sender with a drill and the manual salvaged from a wreck), which digs wider and faster still; game.player then gives tools: {drill: true, turret: true, powerDrill: true}. Refused for a ship that is not a cabin, a cabin whose bench is not placed, an unknown item, a tool the sender already has, or a pack without the materials.",
    "args": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "description": "What to craft: drill, turret or powerDrill"
        }
      },
      "required": [
        "item"
      ]
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "crafted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "item",
            "type": "string",
            "description": "What to craft"
          }
        ]
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 300
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the cabin",
      "position": {
        "x": 500,
        "y": 150
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "packKey",
      "type": "data.expression",
      "title": "Pack key",
      "position": {
        "x": 750,
        "y": 400
      },
      "config": {
        "expr": "(ship?.world ?? \"\") + \".\" + user",
        "type": "string"
      }
    },
    {
      "id": "pack",
      "type": "live.readProjection",
      "title": "Read the sender's pack",
      "position": {
        "x": 1000,
        "y": 400
      },
      "config": {
        "projector": "game.packs"
      }
    },
    {
      "id": "player",
      "type": "live.readProjection",
      "title": "Read the sender's progress",
      "position": {
        "x": 1000,
        "y": 600
      },
      "config": {
        "projector": "game.players"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 1300,
        "y": 150
      },
      "config": {
        "expr": "let need = item == \"turret\" ? {ore: 2, rock: 1.5} : item == \"powerDrill\" ? {ore: 2.5, rock: 1} : {ore: 2, rock: 1}; !found ? \"there is no cabin \" + target : ship.design != \"cabin\" ? \"only a cabin has a field bench\" : !(74 in ship.placed) ? \"the cabin's field bench is not placed yet\" : !(item in [\"drill\", \"turret\", \"powerDrill\"]) ? \"the bench knows two recipes: drill and turret, and a third from a manual\" : item == \"powerDrill\" \u0026\u0026 !(player?.manuals?.powerDrill ?? false) ? \"the bench needs the powered drill's manual: salvage it from a wreck\" : item == \"powerDrill\" \u0026\u0026 !(player?.tools?.drill ?? false) ? \"a powered drill is built on a hand drill: craft that first\" : (player?.tools?.[item] ?? false) ? \"you already have a \" + item : (pack?.ore ?? 0) \u003c need.ore || (pack?.rock ?? 0) \u003c need.rock ? \"a \" + item + \" takes \" + string(need.ore) + \" m³ of ore and \" + string(need.rock) + \" m³ of rock from your pack\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1550,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "id": "crafted",
      "type": "data.expression",
      "title": "Crafted",
      "position": {
        "x": 1800,
        "y": 350
      },
      "config": {
        "expr": "{world: ship.world, item: item, pack: item == \"turret\" ? {ore: -2, rock: -1.5} : item == \"powerDrill\" ? {ore: -2.5, rock: -1} : {ore: -2, rock: -1}}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 2100,
        "y": -100
      },
      "config": {
        "event": "crafted"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 2100,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "place the bench (block 74) with game.placeBlock, and bring the ore from the asteroids and the rock the recipe takes (drill: 2 and 1 m³; turret: 2 and 1.5 m³)"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "shipKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "shipKey",
        "pin": "value"
      },
      "to": {
        "node": "ship",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "packKey",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "packKey",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "packKey",
        "pin": "value"
      },
      "to": {
        "node": "pack",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "packKey",
        "pin": "value"
      },
      "to": {
        "node": "player",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "item"
      },
      "to": {
        "node": "check",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "pack",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "pack"
      }
    },
    {
      "from": {
        "node": "player",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "player"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "crafted",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "item"
      },
      "to": {
        "node": "crafted",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "crafted",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
