{
  "id": "cmd-game-damageShip",
  "name": "game.damageShip",
  "description": "Decides which of a ship's blocks a crash broke, as its pilot's window reckoned it.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.damageShip",
    "title": "Break a ship's blocks",
    "description": "Breaks blocks of a ship that struck the ground too hard, by their indices in its design; the target is the ship's id. The pilot's window sends it when a landing is harder than 5 m/s. Broken blocks go back to the outline, to be placed again with game.placeBlock; a broken cockpit puts the pilot out. Refused when the ship does not exist, the sender is not flying it, or no index is one of its placed blocks.",
    "args": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "The broken blocks' indices in the design"
        }
      },
      "required": [
        "blocks"
      ]
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "damaged"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "blocks",
            "type": "json",
            "description": "The broken blocks' indices"
          }
        ]
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 0
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the ship",
      "position": {
        "x": 500,
        "y": 0
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "hit",
      "type": "data.expression",
      "title": "The placed blocks among them",
      "position": {
        "x": 800,
        "y": 300
      },
      "config": {
        "expr": "found \u0026\u0026 type(blocks) == \"array\" ? uniq(filter(blocks, # in ship.placed)) : []",
        "type": "json"
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "!found ? \"there is no ship \" + target : ship.pilot != user ? \"only the ship's pilot reports what a crash broke\" : len(hit) == 0 ? \"none of those blocks is placed\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1300,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1550,
        "y": 0
      }
    },
    {
      "id": "damaged",
      "type": "data.expression",
      "title": "What broke",
      "position": {
        "x": 1550,
        "y": 350
      },
      "config": {
        "expr": "{world: ship.world, blocks: hit}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1850,
        "y": -100
      },
      "config": {
        "event": "damaged"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1850,
        "y": 150
      },
      "config": {
        "path": "args.blocks",
        "fix": "send the placed blocks a crash broke while flying the ship"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "shipKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "shipKey",
        "pin": "value"
      },
      "to": {
        "node": "ship",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "hit",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "hit",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "blocks"
      },
      "to": {
        "node": "hit",
        "pin": "blocks"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "check",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "hit",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "hit"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "damaged",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "hit",
        "pin": "value"
      },
      "to": {
        "node": "damaged",
        "pin": "hit"
      }
    },
    {
      "from": {
        "node": "damaged",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
