{
  "id": "cmd-game-crewShip",
  "name": "game.crewShip",
  "description": "Decides who rides a ship as its crew: boarding takes its crew seat, leaving gives it up.",
  "kind": "command",
  "version": 1,
  "spec": {
    "command": "game.crewShip",
    "title": "Crew a ship",
    "description": "Boards a finished ship as its crew, or leaves it; the target is the ship's id. The crew rides where the pilot flies and may run the refinery in flight (game.refineShip). Refused when the ship does not exist, is not finished, the sender flies it, its crew seat is taken, or the sender is not aboard to leave.",
    "args": {
      "type": "object",
      "properties": {
        "aboard": {
          "type": "boolean",
          "description": "True to board and take the crew seat, false to leave it"
        }
      },
      "required": [
        "aboard"
      ]
    },
    "area": "game",
    "targetType": "gameShip",
    "projection": "game.ships",
    "action": "game.play",
    "events": [
      "crewed"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "aboard",
            "type": "bool",
            "description": "Whether the sender boards or leaves"
          }
        ]
      }
    },
    {
      "id": "shipKey",
      "type": "data.expression",
      "title": "Ship key",
      "position": {
        "x": 250,
        "y": 0
      },
      "config": {
        "expr": "\"gameShip.\" + target",
        "type": "string"
      }
    },
    {
      "id": "ship",
      "type": "live.readProjection",
      "title": "Read the ship",
      "position": {
        "x": 500,
        "y": 0
      },
      "config": {
        "projector": "game.ships"
      }
    },
    {
      "id": "user",
      "type": "live.currentUser",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "check",
      "type": "data.expression",
      "title": "Why it is refused",
      "position": {
        "x": 800,
        "y": 150
      },
      "config": {
        "expr": "let crew = found ? (ship.crew ?? []) : []; let seats = {skiff: 1, prospector: 1, hauler: 2}; !found ? \"there is no ship \" + target : !aboard ? (user in crew ? \"\" : \"you are not aboard this ship\") : len(ship.placed) \u003c ship.blocks ? \"finish the ship before crewing it\" : ship.pilot == user ? \"you are flying this ship; leave the seat first\" : user in crew ? \"you are already aboard\" : len(crew) \u003e= (seats[ship.design] ?? 0) ? \"the ship's crew seat is taken\" : \"\"",
        "type": "string"
      }
    },
    {
      "id": "ok",
      "type": "data.expression",
      "title": "Allowed?",
      "position": {
        "x": 1050,
        "y": 150
      },
      "config": {
        "expr": "problem == \"\"",
        "type": "bool"
      }
    },
    {
      "id": "branch",
      "type": "flow.branch",
      "position": {
        "x": 1300,
        "y": 0
      }
    },
    {
      "id": "crewed",
      "type": "data.expression",
      "title": "Who boards or leaves",
      "position": {
        "x": 1300,
        "y": 350
      },
      "config": {
        "expr": "{world: ship.world, user: user, aboard: aboard}",
        "type": "json"
      }
    },
    {
      "id": "emit",
      "type": "live.emit",
      "position": {
        "x": 1600,
        "y": -100
      },
      "config": {
        "event": "crewed"
      }
    },
    {
      "id": "reject",
      "type": "live.reject",
      "position": {
        "x": 1600,
        "y": 150
      },
      "config": {
        "path": "args",
        "fix": "board a finished ship whose crew seat is free, or leave one you are aboard"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "branch",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "shipKey",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "shipKey",
        "pin": "value"
      },
      "to": {
        "node": "ship",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "exists"
      },
      "to": {
        "node": "check",
        "pin": "found"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "check",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "check",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "aboard"
      },
      "to": {
        "node": "check",
        "pin": "aboard"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "check",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "problem"
      }
    },
    {
      "from": {
        "node": "ok",
        "pin": "value"
      },
      "to": {
        "node": "branch",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "true"
      },
      "to": {
        "node": "emit",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "branch",
        "pin": "false"
      },
      "to": {
        "node": "reject",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "check",
        "pin": "value"
      },
      "to": {
        "node": "reject",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "ship",
        "pin": "value"
      },
      "to": {
        "node": "crewed",
        "pin": "ship"
      }
    },
    {
      "from": {
        "node": "user",
        "pin": "user"
      },
      "to": {
        "node": "crewed",
        "pin": "user"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "aboard"
      },
      "to": {
        "node": "crewed",
        "pin": "aboard"
      }
    },
    {
      "from": {
        "node": "crewed",
        "pin": "value"
      },
      "to": {
        "node": "emit",
        "pin": "data"
      }
    }
  ]
}
