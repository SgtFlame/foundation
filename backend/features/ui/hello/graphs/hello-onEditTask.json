{
  "id": "hello-onEditTask",
  "name": "On edit task",
  "description": "A task's cell was changed: done toggles the task with task.toggle; other fields are set with record.update.",
  "kind": "ui.handler",
  "version": 1,
  "owner": "app:hello",
  "nodes": [
    {
      "id": "event",
      "type": "ui.onEvent",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "key",
            "type": "string",
            "description": "The task's id"
          },
          {
            "id": "field",
            "type": "string",
            "description": "The field's id"
          },
          {
            "id": "value",
            "type": "any",
            "description": "The new value"
          }
        ]
      }
    },
    {
      "id": "isDone",
      "type": "data.expression",
      "position": {
        "x": 300,
        "y": 250
      },
      "config": {
        "expr": "field == \"done\"",
        "type": "bool"
      },
      "title": "Done?"
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 300,
        "y": 0
      }
    },
    {
      "id": "toggle",
      "type": "live.sendCommand",
      "position": {
        "x": 600,
        "y": -100
      },
      "config": {
        "command": "task.toggle"
      }
    },
    {
      "id": "args",
      "type": "data.expression",
      "position": {
        "x": 600,
        "y": 300
      },
      "config": {
        "expr": "{entity: \"task\", set: fromPairs([[field, value]])}",
        "type": "json"
      },
      "title": "Set the field"
    },
    {
      "id": "set",
      "type": "live.sendCommand",
      "position": {
        "x": 600,
        "y": 100
      },
      "config": {
        "command": "record.update"
      }
    },
    {
      "id": "toast",
      "type": "ui.toast",
      "position": {
        "x": 900,
        "y": -100
      },
      "config": {
        "severity": "error"
      },
      "title": "Toast the refusal"
    },
    {
      "id": "toast2",
      "type": "ui.toast",
      "position": {
        "x": 900,
        "y": 100
      },
      "config": {
        "severity": "error"
      },
      "title": "Toast the refusal"
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "if",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "field"
      },
      "to": {
        "node": "isDone",
        "pin": "field"
      }
    },
    {
      "from": {
        "node": "isDone",
        "pin": "value"
      },
      "to": {
        "node": "if",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "true"
      },
      "to": {
        "node": "toggle",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "false"
      },
      "to": {
        "node": "set",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "key"
      },
      "to": {
        "node": "toggle",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "key"
      },
      "to": {
        "node": "set",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "field"
      },
      "to": {
        "node": "args",
        "pin": "field"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "value"
      },
      "to": {
        "node": "args",
        "pin": "value"
      }
    },
    {
      "from": {
        "node": "args",
        "pin": "value"
      },
      "to": {
        "node": "set",
        "pin": "args"
      }
    },
    {
      "from": {
        "node": "toggle",
        "pin": "rejected"
      },
      "to": {
        "node": "toast",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "toggle",
        "pin": "message"
      },
      "to": {
        "node": "toast",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "set",
        "pin": "rejected"
      },
      "to": {
        "node": "toast2",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "set",
        "pin": "message"
      },
      "to": {
        "node": "toast2",
        "pin": "message"
      }
    }
  ]
}
