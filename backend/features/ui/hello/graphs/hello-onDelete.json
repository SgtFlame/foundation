{
  "id": "hello-onDelete",
  "name": "On delete",
  "description": "Removes each edge the user deleted from the shared graph.",
  "kind": "ui.handler",
  "version": 1,
  "owner": "app:hello",
  "nodes": [
    {
      "id": "event",
      "type": "ui.onEvent",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "edges",
            "type": "any",
            "description": "The deleted edges' ids"
          }
        ]
      }
    },
    {
      "id": "each",
      "type": "flow.forEach",
      "position": {
        "x": 300,
        "y": 0
      }
    },
    {
      "id": "args",
      "type": "data.makeObject",
      "position": {
        "x": 600,
        "y": 200
      },
      "config": {
        "fields": [
          "id"
        ]
      }
    },
    {
      "id": "send",
      "type": "live.sendCommand",
      "position": {
        "x": 900,
        "y": 0
      },
      "config": {
        "command": "hello.disconnect",
        "target": "main"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "each",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "edges"
      },
      "to": {
        "node": "each",
        "pin": "list"
      }
    },
    {
      "from": {
        "node": "each",
        "pin": "body"
      },
      "to": {
        "node": "send",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "each",
        "pin": "item"
      },
      "to": {
        "node": "args",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "args",
        "pin": "object"
      },
      "to": {
        "node": "send",
        "pin": "args"
      }
    }
  ]
}
