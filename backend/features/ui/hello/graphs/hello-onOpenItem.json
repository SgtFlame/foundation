{
  "id": "hello-onOpenItem",
  "name": "On open item",
  "description": "Opens an item as its own top-level tab.",
  "kind": "ui.handler",
  "version": 1,
  "owner": "app:hello",
  "nodes": [
    {
      "id": "event",
      "type": "ui.onEvent",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "id",
            "type": "string",
            "description": "The item's id"
          }
        ]
      }
    },
    {
      "id": "name",
      "type": "data.template",
      "position": {
        "x": 300,
        "y": 200
      },
      "config": {
        "template": "Hello item {{id}}"
      }
    },
    {
      "id": "open",
      "type": "ui.openEditor",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "kind": "item",
        "helpText": "An item of the Hello app"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "open",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "id"
      },
      "to": {
        "node": "open",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "id"
      },
      "to": {
        "node": "name",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "name",
        "pin": "text"
      },
      "to": {
        "node": "open",
        "pin": "name"
      }
    }
  ]
}
