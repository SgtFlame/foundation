{
  "id": "hello-onTaskRenamed",
  "name": "On task renamed",
  "description": "A Task row raised renamed: sets the task's title with record.update.",
  "kind": "ui.handler",
  "version": 1,
  "owner": "app:hello",
  "nodes": [
    {
      "id": "event",
      "type": "ui.onEvent",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "id",
            "type": "string",
            "description": "The task's id"
          },
          {
            "id": "title",
            "type": "string",
            "description": "Its new title"
          }
        ]
      }
    },
    {
      "id": "args",
      "type": "data.expression",
      "position": {
        "x": 300,
        "y": 200
      },
      "config": {
        "expr": "{entity: \"task\", set: {title: title}}",
        "type": "json"
      },
      "title": "Set the title"
    },
    {
      "id": "send",
      "type": "live.sendCommand",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "command": "record.update"
      }
    },
    {
      "id": "toast",
      "type": "ui.toast",
      "position": {
        "x": 600,
        "y": 0
      },
      "config": {
        "severity": "error"
      },
      "title": "Toast the refusal"
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "send",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "id"
      },
      "to": {
        "node": "send",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "title"
      },
      "to": {
        "node": "args",
        "pin": "title"
      }
    },
    {
      "from": {
        "node": "args",
        "pin": "value"
      },
      "to": {
        "node": "send",
        "pin": "args"
      }
    },
    {
      "from": {
        "node": "send",
        "pin": "rejected"
      },
      "to": {
        "node": "toast",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "send",
        "pin": "message"
      },
      "to": {
        "node": "toast",
        "pin": "message"
      }
    }
  ]
}
