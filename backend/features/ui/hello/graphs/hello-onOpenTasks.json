{
  "id": "hello-onOpenTasks",
  "name": "On open tasks",
  "description": "Opens the task list as its own top-level tab.",
  "kind": "ui.handler",
  "version": 1,
  "owner": "app:hello",
  "nodes": [
    {
      "id": "event",
      "type": "ui.onEvent",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "open",
      "type": "ui.openEditor",
      "position": {
        "x": 300,
        "y": 0
      },
      "config": {
        "kind": "tasks",
        "helpText": "The Hello app's shared task list"
      }
    },
    {
      "id": "id",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 200
      },
      "config": {
        "expr": "\"main\"",
        "type": "string"
      },
      "title": "main"
    },
    {
      "id": "name",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 300
      },
      "config": {
        "expr": "\"Tasks\"",
        "type": "string"
      },
      "title": "Tasks"
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "open",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "id",
        "pin": "value"
      },
      "to": {
        "node": "open",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "name",
        "pin": "value"
      },
      "to": {
        "node": "open",
        "pin": "name"
      }
    }
  ]
}
