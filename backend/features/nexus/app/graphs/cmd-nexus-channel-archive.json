{
  "id": "cmd-nexus-channel-archive",
  "name": "nexus.channel.archive",
  "description": "Archives the target channel: it stays readable, but no one posts in it or joins it. Only its owner archives it.",
  "kind": "command",
  "version": 1,
  "owner": "app:nexus",
  "spec": {
    "command": "channel.archive",
    "title": "Archive a channel",
    "description": "Archives the target channel: it stays readable, but no one posts in it or joins it. Only its owner archives it.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "rec",
    "targetType": "nexusChannel",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "{problem: state == nil ? \"there is no channel \" + target : string(state.owner ?? \"\") != me ? \"only the channel's owner archives it\" : state.archived ?? false ? \"the channel is already archived\" : \"\",\n channels: [{id: target, set: {archived: true}, expect: state?._seq}]}\n",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1020,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "expr": "plan.channels ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "update nexusChannel (channels)",
      "position": {
        "x": 1360,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.update",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "entity": "nexusChannel"
      }
    },
    {
      "id": "w0s",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 200
      },
      "config": {
        "expr": "item.set",
        "type": "json"
      }
    },
    {
      "id": "w0x",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 400
      },
      "config": {
        "expr": "item.expect",
        "type": "number"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "state"
      },
      "to": {
        "node": "plan",
        "pin": "state"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "plan",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "me",
        "pin": "user"
      },
      "to": {
        "node": "plan",
        "pin": "me"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "refused",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "if",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "refused",
        "pin": "value"
      },
      "to": {
        "node": "if",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "why",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "true"
      },
      "to": {
        "node": "no",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "why",
        "pin": "value"
      },
      "to": {
        "node": "no",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "w0list",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "false"
      },
      "to": {
        "node": "w0",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "w0list",
        "pin": "value"
      },
      "to": {
        "node": "w0",
        "pin": "list"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "item"
      },
      "to": {
        "node": "w0id",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "body"
      },
      "to": {
        "node": "w0w",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "w0id",
        "pin": "value"
      },
      "to": {
        "node": "w0w",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "item"
      },
      "to": {
        "node": "w0s",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "w0s",
        "pin": "value"
      },
      "to": {
        "node": "w0w",
        "pin": "set"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "item"
      },
      "to": {
        "node": "w0x",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "w0x",
        "pin": "value"
      },
      "to": {
        "node": "w0w",
        "pin": "expect"
      }
    }
  ]
}
