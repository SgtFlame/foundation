{
  "id": "nexus-onMember",
  "name": "A membership changed",
  "description": "Keeps private channels' access in step with their memberships, as the app: a new member of a private channel gets the member role on it when whoever added them is its owner or holds that role there; a member who leaves loses it.",
  "kind": "app.trigger",
  "version": 1,
  "owner": "app:nexus",
  "nodes": [
    {
      "id": "event",
      "type": "records.onChanged",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "entity": "nexusMember",
        "events": [
          "created",
          "deleted"
        ]
      }
    },
    {
      "id": "rec",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "type": "json",
        "expr": "record ?? old ?? {}"
      }
    },
    {
      "id": "cid",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "type": "string",
        "expr": "string(rec.channel ?? \"\")"
      }
    },
    {
      "id": "chan",
      "type": "records.get",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "entity": "nexusChannel"
      }
    },
    {
      "id": "held",
      "type": "authz.grants",
      "position": {
        "x": 1020,
        "y": 200
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "type": "json",
        "expr": "let creator = string(rec._createdBy ?? \"\");\nlet user = string(rec.user ?? \"\");\nlet holders = map(filter(grants ?? [], #.role == \"member\"), string(#.user ?? \"\"));\n{grant: kind == \"created\" \u0026\u0026 (rec.private ?? false) \u0026\u0026 chan != nil \u0026\u0026 user != \"\" \u0026\u0026 (creator == string(chan.owner ?? \"\") || creator in holders),\n revoke: kind == \"deleted\" \u0026\u0026 (rec.private ?? false) \u0026\u0026 user in holders, user: user}"
      }
    },
    {
      "id": "grant?",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "type": "bool",
        "expr": "plan.grant"
      }
    },
    {
      "id": "revoke?",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 200
      },
      "config": {
        "type": "bool",
        "expr": "plan.revoke"
      }
    },
    {
      "id": "user",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 400
      },
      "config": {
        "type": "string",
        "expr": "plan.user"
      }
    },
    {
      "id": "entity",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 200
      },
      "config": {
        "type": "string",
        "expr": "\"nexusChannel\""
      }
    },
    {
      "id": "role",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 400
      },
      "config": {
        "type": "string",
        "expr": "\"member\""
      }
    },
    {
      "id": "if1",
      "type": "flow.branch",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "if2",
      "type": "flow.branch",
      "position": {
        "x": 2380,
        "y": 0
      }
    },
    {
      "id": "give",
      "type": "authz.grantRole",
      "position": {
        "x": 2380,
        "y": 200
      }
    },
    {
      "id": "take",
      "type": "authz.revokeRole",
      "position": {
        "x": 2720,
        "y": 0
      }
    }
  ],
  "edges": [
