{
  "id": "cmd-nexus-message-edit",
  "name": "nexus.message.edit",
  "description": "Replaces the text of the target message. Only its author edits it, and not once it is deleted.",
  "kind": "command",
  "version": 1,
  "owner": "app:nexus",
  "spec": {
    "command": "message.edit",
    "title": "Edit a message",
    "description": "Replaces the text of the target message. Only its author edits it, and not once it is deleted.",
    "args": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The new Markdown text"
        }
      },
      "required": [
        "text"
      ]
    },
    "area": "rec",
    "targetType": "nexusMessage",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "let text = trim(args.text ?? \"\");\n{problem: state == nil ? \"there is no message \" + target : state.deleted ?? false ? \"the message was deleted\" : string(state.author ?? \"\") != me ? \"only its author edits a message\" : text == \"\" ? \"a message needs text; delete it instead\" : \"\",\n messages: [{id: target, set: {text: text, edited: true}, expect: state?._seq}]}\n",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1020,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "expr": "plan.messages ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "update nexusMessage (messages)",
      "position": {
        "x": 1360,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.update",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "entity": "nexusMessage"
      }
    },
    {
      "id": "w0s",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 200
      },
      "config": {
        "expr": "item.set",
        "type": "json"
      }
    },
    {
      "id": "w0x",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 400
      },
      "config": {
        "expr": "item.expect",
        "type": "number"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "args"
      },
      "to": {
        "node": "plan",
        "pin": "args"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "state"
      },
      "to": {
        "node": "plan",
        "pin": "state"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "plan",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "me",
        "pin": "user"
      },
      "to": {
        "node": "plan",
        "pin": "me"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "refused",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "if",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "refused",
        "pin": "value"
      },
      "to": {
        "node": "if",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "why",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "true"
      },
      "to": {
        "node": "no",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "why",
        "pin": "value"
      },
      "to": {
        "node": "no",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "w0list",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "false"
      },
      "to": {
        "node": "w0",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "w0list",
        "pin": "value"
      },
      "to": {
        "node": "w0",
        "pin": "list"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "item"
      },
      "to": {
        "node": "w0id",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "body"
      },
      "to": {
        "node": "w0w",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "w0id",
        "pin": "value"
      },
      "to": {
        "node": "w0w",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "item"
      },
      "to": {
        "node": "w0s",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "w0s",
        "pin": "value"
      },
      "to": {
        "node": "w0w",
        "pin": "set"
      }
    },
    {
      "from": {
        "node": "w0",
        "pin": "item"
      },
      "to": {
        "node": "w0x",
        "pin": "item"
      }
    },
    {
      "from": {
        "node": "w0x",
