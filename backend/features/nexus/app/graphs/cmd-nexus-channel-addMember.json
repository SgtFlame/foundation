{
  "id": "cmd-nexus-channel-addMember",
  "name": "nexus.channel.addMember",
  "description": "Adds a person (args.user, a user id) to the target channel as a member. Only a member adds people to a private channel; nobody is added to a direct conversation or an archived channel. Adding a member again changes nothing.",
  "kind": "command",
  "version": 1,
  "owner": "app:nexus",
  "spec": {
    "command": "channel.addMember",
    "title": "Add someone to a channel",
    "description": "Adds a person (args.user, a user id) to the target channel as a member. Only a member adds people to a private channel; nobody is added to a direct conversation or an archived channel. Adding a member again changes nothing.",
    "args": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "description": "The user id of the person to add"
        }
      },
      "required": [
        "user"
      ]
    },
    "area": "rec",
    "targetType": "nexusChannel",
    "projection": "records.record",
    "action": "record.read",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "seen",
      "type": "records.get",
      "title": "The channel as the caller may see it",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "entity": "nexusChannel"
      }
    },
    {
      "id": "mineId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "type": "string",
        "expr": "target + \"-\" + me"
      }
    },
    {
      "id": "mine",
      "type": "records.get",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "nexusMember"
      }
    },
    {
      "id": "theirsId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 400
      },
      "config": {
        "type": "string",
        "expr": "target + \"-\" + string(args.user ?? \"\")"
      }
    },
    {
      "id": "theirs",
      "type": "records.get",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "entity": "nexusMember"
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "let u = string(args.user ?? \"\");\n{problem: state == nil || seen == nil ? \"there is no channel \" + target : u == \"\" ? \"name the person to add\" : state.kind == \"direct\" ? \"a direct conversation stays between its two people\" : state.archived ?? false ? \"the channel is archived\" : mine == nil \u0026\u0026 string(state.owner ?? \"\") != me ? \"only a member of the channel adds people\" : \"\",\n members: theirs != nil ? [] : [{id: target + \"-\" + u, values: {channel: target, user: u, role: \"member\", private: state.private ?? false, owner: state.owner, seen: 0}}]}\n",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1700,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 400
      },
      "config": {
        "expr": "plan.members ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "create nexusMember (members)",
      "position": {
        "x": 2040,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.create",
      "position": {
        "x": 2720,
        "y": 0
      },
      "config": {
        "entity": "nexusMember"
      }
    },
    {
      "id": "w0v",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 200
      },
      "config": {
        "expr": "item.values",
        "type": "json"
      }
    }
  ],
