    },
    {
      "id": "w1w",
      "type": "records.create",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "entity": "nexusMember"
      }
    },
    {
      "id": "w1v",
      "type": "data.expression",
      "position": {
        "x": 2040,
        "y": 400
      },
      "config": {
        "expr": "item.values",
        "type": "json"
      }
    }
  ],
