{
  "id": "cmd-nexus-message-post",
  "name": "nexus.message.post",
  "description": "Posts a message, its target the id the sender's browser made (so a message sent twice is one): in args.channel, Markdown text, the user ids it mentions, its files ({id, name, size, contentType}, uploaded as files of nexusMessage) and, in a thread, the message it replies to (parent). Only a member of the channel posts, and not in an archived one.",
  "kind": "command",
  "version": 1,
  "owner": "app:nexus",
  "spec": {
    "command": "message.post",
    "title": "Post a message",
    "description": "Posts a message, its target the id the sender's browser made (so a message sent twice is one): in args.channel, Markdown text, the user ids it mentions, its files ({id, name, size, contentType}, uploaded as files of nexusMessage) and, in a thread, the message it replies to (parent). Only a member of the channel posts, and not in an archived one.",
    "args": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "description": "The channel's id"
        },
        "text": {
          "type": "string",
          "description": "Markdown"
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The user ids it mentions"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Uploaded files: {id, name, size, contentType}"
        },
        "parent": {
          "type": "string",
          "description": "The message it replies to, in a thread"
        }
      },
      "required": [
        "channel"
      ]
    },
    "area": "rec",
    "targetType": "nexusMessage",
    "projection": "records.record",
    "action": "record.create",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "chanId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "type": "string",
        "expr": "args.channel ?? \"\""
      }
    },
    {
      "id": "chan",
      "type": "records.get",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "nexusChannel"
      }
    },
    {
      "id": "mineId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "type": "string",
        "expr": "(args.channel ?? \"\") + \"-\" + me"
      }
    },
    {
      "id": "mine",
      "type": "records.get",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "entity": "nexusMember"
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "let a = args;\nlet text = trim(a.text ?? \"\");\nlet files = a.files ?? [];\n{problem: state != nil ? \"\" : chan == nil ? \"there is no channel \" + (a.channel ?? \"\") : chan.archived ?? false ? \"the channel is archived\" : mine == nil ? \"join the channel before posting in it\" : text == \"\" \u0026\u0026 len(files) == 0 ? \"write something or attach a file\" : \"\",\n messages: state != nil ? [] : [{id: target, values: {channel: chan?._id ?? \"\", author: me, text: text, parent: a.parent ?? \"\", mentions: a.mentions ?? [], files: files, private: chan?.private ?? false}}]}\n",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1700,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 400
      },
      "config": {
        "expr": "plan.messages ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "create nexusMessage (messages)",
      "position": {
        "x": 2040,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.create",
      "position": {
        "x": 2720,
        "y": 0
      },
      "config": {
        "entity": "nexusMessage"
      }
    },
    {
      "id": "w0v",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 200
      },
      "config": {
        "expr": "item.values",
        "type": "json"
      }
    }
  ],
  "edges": [
    {
