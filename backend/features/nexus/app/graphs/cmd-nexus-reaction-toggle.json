{
  "id": "cmd-nexus-reaction-toggle",
  "name": "nexus.reaction.toggle",
  "description": "Adds the emoji (args.emoji, the character) to the caller's reactions to the target message, or takes it away when they already reacted with it.",
  "kind": "command",
  "version": 1,
  "owner": "app:nexus",
  "spec": {
    "command": "reaction.toggle",
    "title": "React to a message",
    "description": "Adds the emoji (args.emoji, the character) to the caller's reactions to the target message, or takes it away when they already reacted with it.",
    "args": {
      "type": "object",
      "properties": {
        "emoji": {
          "type": "string",
          "description": "The emoji: 👍"
        }
      },
      "required": [
        "emoji"
      ]
    },
    "area": "rec",
    "targetType": "nexusMessage",
    "projection": "records.record",
    "action": "record.read",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "mineId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "type": "string",
        "expr": "target + \"-\" + me"
      }
    },
    {
      "id": "mine",
      "type": "records.get",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "nexusReaction"
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "let e = trim(args.emoji ?? \"\");\nlet had = mine?.emoji ?? [];\nlet next = e in had ? filter(had, # != e) : concat(had, [e]);\n{problem: state == nil ? \"there is no message \" + target : state.deleted ?? false ? \"the message was deleted\" : e == \"\" ? \"choose an emoji\" : me == \"\" ? \"only a person reacts\" : \"\",\n added: mine != nil ? [] : [{id: target + \"-\" + me, values: {message: target, channel: state?.channel ?? \"\", user: me, emoji: [e], private: state?.private ?? false}}],\n changed: mine != nil \u0026\u0026 len(next) \u003e 0 ? [{id: mine?._id ?? \"\", set: {emoji: next}, expect: mine?._seq}] : [],\n removed: mine != nil \u0026\u0026 len(next) == 0 ? [{id: mine?._id ?? \"\"}] : []}\n",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1700,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 400
      },
      "config": {
        "expr": "plan.added ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "create nexusReaction (added)",
      "position": {
        "x": 2040,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.create",
      "position": {
        "x": 2720,
        "y": 0
      },
      "config": {
        "entity": "nexusReaction"
      }
    },
    {
      "id": "w0v",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 200
