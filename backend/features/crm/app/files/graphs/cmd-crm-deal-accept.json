{
  "id": "cmd-crm-deal-accept",
  "name": "crm.deal.accept",
  "description": "Accepts the target proposed deal (one an agent suggested): it becomes active and shows on the pipeline. Refused for a deal that is not proposed.",
  "kind": "command",
  "version": 1,
  "owner": "app:crm",
  "spec": {
    "command": "deal.accept",
    "title": "Accept a proposed deal",
    "description": "Accepts the target deal an agent proposed (state proposed): it becomes active. Refused when it is not proposed.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "rec",
    "targetType": "crmDeal",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "updated"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "{problem: deal == nil ? \"there is no deal \" + target : (deal.state ?? \"active\") != \"proposed\" ? \"the deal \" + string(deal.name ?? \"\") + \" is not a proposal\" : \"\"}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1020,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "set",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 200
      },
      "config": {
        "expr": "{state: \"active\"}",
        "type": "json"
      }
    },
    {
      "id": "up",
      "type": "records.update",
      "position": {
        "x": 1360,
        "y": 200
      },
      "config": {
        "entity": "crmDeal"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "state"
      },
      "to": {
        "node": "plan",
        "pin": "deal"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "plan",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "refused",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "if",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "refused",
        "pin": "value"
      },
      "to": {
        "node": "if",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "plan",
        "pin": "value"
      },
      "to": {
        "node": "why",
        "pin": "plan"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "true"
      },
      "to": {
        "node": "no",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "why",
        "pin": "value"
      },
      "to": {
        "node": "no",
        "pin": "message"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "false"
      },
      "to": {
        "node": "up",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "target"
      },
      "to": {
        "node": "up",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "set",
        "pin": "value"
      },
      "to": {
        "node": "up",
        "pin": "set"
      }
    }
  ]
}
