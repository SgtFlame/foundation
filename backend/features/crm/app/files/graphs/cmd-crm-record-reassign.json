{
  "id": "cmd-crm-record-reassign",
  "name": "crm.record.reassign",
  "description": "Gives a company, contact, deal or activity a new owner, for Sales managers only (a sales rep may not hand their records to someone else). The target is the record's id.",
  "kind": "command",
  "version": 1,
  "owner": "app:crm",
  "spec": {
    "command": "record.reassign",
    "title": "Reassign a record",
    "description": "Sets the owner of the target record (its id) of entity crmCompany, crmContact, crmDeal or crmActivity to owner (a user id; empty for shared). Sales managers only.",
    "args": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "crmCompany",
            "crmContact",
            "crmDeal",
            "crmActivity"
          ],
          "description": "The record's entity type"
        },
        "owner": {
          "type": "string",
          "description": "The new owner's user id; empty makes it shared"
        }
      },
      "required": [
        "entity",
        "owner"
      ]
    },
    "area": "rec",
    "targetType": "reassign",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "updated"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "tenant",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 200
      },
      "config": {
        "expr": "\"tenant\"",
        "type": "string"
      }
    },
    {
      "id": "mgr",
      "type": "authz.hasRole",
      "title": "Is a Sales manager?",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "role": "manager"
      }
    },
    {
      "id": "entity",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "expr": "args.entity in [\"crmCompany\", \"crmContact\", \"crmDeal\", \"crmActivity\"] ? args.entity : \"crmDeal\"",
        "type": "string"
      }
    },
    {
      "id": "rec",
      "type": "records.get",
      "title": "The record",
      "position": {
        "x": 680,
        "y": 0
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "let owner = trim(args.owner ?? \"\");\nlet set = {owner: owner == \"\" ? nil : owner};\nlet w = [{id: target, set: set}];\n{problem: !mgr ? \"only a Sales manager may reassign records\"\n  : !(args.entity in [\"crmCompany\", \"crmContact\", \"crmDeal\", \"crmActivity\"]) ? \"the entity is crmCompany, crmContact, crmDeal or crmActivity\"\n  : rec == nil ? \"there is no \" + args.entity + \" \" + target : \"\",\n company: args.entity == \"crmCompany\" ? w : [],\n contact: args.entity == \"crmContact\" ? w : [],\n deal: args.entity == \"crmDeal\" ? w : [],\n activity: args.entity == \"crmActivity\" ? w : []}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1700,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 400
      },
      "config": {
        "expr": "plan.company",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "update crmCompany",
      "position": {
        "x": 2040,
        "y": 200
      }
    },
    {
