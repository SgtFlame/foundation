{
  "name": "chat_messaging_message_post",
  "title": "Post a message",
  "description": "Posts a message in a channel, or as a reply in a thread, as the connection's account, under our key (a post with a key already used posts nothing and gives that message). Mention a member as @\u003cmember id\u003e; attach files uploaded with file.upload by their ids.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "description": "The channel's id"
      },
      "key": {
        "type": "string",
        "description": "Our id for the message, the idempotency key"
      },
      "text": {
        "type": "string",
        "description": "The text as Markdown"
      },
      "thread": {
        "type": "string",
        "description": "Reply in the thread this message starts"
      },
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Ids of files uploaded with file.upload"
      }
    },
    "required": [
      "channel",
      "key",
      "text"
    ]
  },
  "outputSchema": {
    "type": "object",
    "description": "A message",
    "properties": {
      "id": {
        "type": "string",
        "description": "The message's id at the service"
      },
      "channel": {
        "type": "string",
        "description": "Its channel's id"
      },
      "thread": {
        "type": "string",
        "description": "For a reply: the id of the message that starts its thread"
      },
      "key": {
        "type": "string",
        "description": "The key it was posted with through this contract, when it was; bridges know their own posts by it"
      },
      "author": {
        "type": "object",
        "description": "Who posted it",
        "properties": {
          "id": {
            "type": "string",
            "description": "Their id"
          },
          "name": {
            "type": "string",
            "description": "Their name"
          },
          "bot": {
            "type": "boolean",
            "description": "Whether a bot posted it"
          }
        },
        "required": [
          "id"
        ]
      },
      "text": {
        "type": "string",
        "description": "Its text as Markdown, mentions as @\u003cmember id\u003e"
      },
      "mentions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The member ids it mentions"
      },
      "files": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "A file attached to a message",
          "properties": {
            "id": {
              "type": "string",
              "description": "The file's id at the service"
            },
            "name": {
              "type": "string",
              "description": "Its name"
            },
            "size": {
              "type": "integer",
              "description": "Its size in bytes"
            },
            "contentType": {
              "type": "string",
              "description": "Its media type"
            },
            "url": {
              "type": "string",
              "description": "Where the service serves it to the connection"
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        "description": "Its files"
      },
      "reactions": {
        "type": "array",
        "description": "Its reactions, one per emoji",
        "items": {
          "type": "object",
          "properties": {
            "emoji": {
              "type": "string",
              "description": "The emoji, e.g. thumbsup"
            },
            "count": {
              "type": "integer",
              "description": "How many reacted"
            },
            "users": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Who reacted"
            }
          },
          "required": [
            "emoji",
            "count"
          ]
        }
      },
      "replies": {
        "type": "integer",
        "description": "How many replies its thread has"
      },
      "posted": {
        "type": "string",
        "description": "When it was posted, RFC 3339"
      },
      "edited": {
        "type": "string",
        "description": "When it was last edited, RFC 3339"
      }
    },
    "required": [
      "id",
      "channel",
      "author",
      "text",
      "posted"
    ]
  },
  "annotations": {
    "title": "Post a message",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  }
}
