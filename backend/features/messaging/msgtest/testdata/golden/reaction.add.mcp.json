{
  "name": "chat_messaging_reaction_add",
  "title": "Add a reaction",
  "description": "Reacts to a message with an emoji as the connection's account. Adding one already there succeeds.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "description": "The channel's id"
      },
      "id": {
        "type": "string",
        "description": "The message's id"
      },
      "emoji": {
        "type": "string",
        "description": "The emoji's name, e.g. thumbsup"
      }
    },
    "required": [
      "channel",
      "id",
      "emoji"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "Always true: a failure is an error"
      }
    },
    "required": [
      "ok"
    ]
  },
  "annotations": {
    "title": "Add a reaction",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  }
}
