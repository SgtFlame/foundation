{
  "name": "tasks_tracker_card_create",
  "title": "Create a card",
  "description": "Makes a card in a list, keyed by our task id: a create with a key already made makes nothing and gives that card.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "description": "Our task id, the idempotency key"
      },
      "board": {
        "type": "string",
        "description": "The board's id"
      },
      "list": {
        "type": "string",
        "description": "The list's id (board.get)"
      },
      "position": {
        "type": "number",
        "description": "Where in the list: a position between its neighbours'; the end when left out"
      },
      "title": {
        "type": "string",
        "description": "Its title"
      },
      "description": {
        "type": "string",
        "description": "Its description, in Markdown"
      },
      "assignees": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Member ids to assign (member.list)"
      },
      "due": {
        "type": "string",
        "description": "When it is due, RFC 3339 or YYYY-MM-DD; empty for none"
      },
      "start": {
        "type": "string",
        "description": "When it starts, RFC 3339 or YYYY-MM-DD; empty for none"
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Label ids (board.get)"
      },
      "checklist": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "A checklist item",
          "properties": {
            "id": {
              "type": "string",
              "description": "The item's outside id; left out for a new one"
            },
            "text": {
              "type": "string",
              "description": "What is to be done"
            },
            "done": {
              "type": "boolean",
              "description": "Whether it is done"
            }
          },
          "required": [
            "text",
            "done"
          ]
        },
        "description": "The whole checklist, in order"
      }
    },
    "required": [
      "key",
      "board",
      "list",
      "title"
    ]
  },
  "outputSchema": {
    "type": "object",
    "description": "A card, issue or task as the tracker reports it",
    "properties": {
      "id": {
        "type": "string",
        "description": "The card's outside id"
      },
      "key": {
        "type": "string",
        "description": "Our task id it was created with (card.create's key), when we made it"
      },
      "board": {
        "type": "string",
        "description": "Its board's id"
      },
      "list": {
        "type": "string",
        "description": "Its list or status's id"
      },
      "title": {
        "type": "string",
        "description": "Its title"
      },
      "description": {
        "type": "string",
        "description": "Its description, in Markdown"
      },
      "assignees": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The ids of the members it is assigned to"
      },
      "due": {
        "type": "string",
        "description": "When it is due, RFC 3339 or YYYY-MM-DD; empty when none"
      },
      "start": {
        "type": "string",
        "description": "When it starts, RFC 3339 or YYYY-MM-DD; empty when none"
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The ids of its labels"
      },
      "checklist": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "A checklist item",
          "properties": {
            "id": {
              "type": "string",
              "description": "The item's outside id; left out for a new one"
            },
            "text": {
              "type": "string",
              "description": "What is to be done"
            },
            "done": {
              "type": "boolean",
              "description": "Whether it is done"
            }
          },
          "required": [
            "text",
            "done"
          ]
        },
        "description": "Its checklist items, in order"
      },
      "position": {
        "type": "number",
        "description": "Sorts its list's cards, smallest first"
      },
      "archived": {
        "type": "boolean",
        "description": "Whether it is archived (closed)"
      },
      "version": {
        "type": "string",
        "description": "The tracker's version of the card, changed by every change; card.update's version"
      },
      "updatedAt": {
        "type": "string",
        "description": "When it last changed, RFC 3339, by the tracker's clock"
      },
      "url": {
        "type": "string",
        "description": "Where it is opened in the tracker"
      }
    },
    "required": [
      "id",
      "board",
      "list",
      "title",
      "version",
      "updatedAt"
    ]
  },
  "annotations": {
    "title": "Create a card",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
