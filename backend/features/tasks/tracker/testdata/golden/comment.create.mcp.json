{
  "name": "tasks_tracker_comment_create",
  "title": "Comment on a card",
  "description": "Adds a comment to a card, keyed by our comment id: a create with a key already made gives that comment.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "description": "Our comment id, the idempotency key"
      },
      "card": {
        "type": "string",
        "description": "The card's id"
      },
      "text": {
        "type": "string",
        "description": "The comment, in Markdown"
      }
    },
    "required": [
      "key",
      "card",
      "text"
    ]
  },
  "outputSchema": {
    "type": "object",
    "description": "A comment on a card",
    "properties": {
      "id": {
        "type": "string",
        "description": "The comment's outside id"
      },
      "key": {
        "type": "string",
        "description": "Our id it was created with (comment.create's key), when we made it"
      },
      "card": {
        "type": "string",
        "description": "The card's id"
      },
      "author": {
        "type": "string",
        "description": "The member id of who wrote it"
      },
      "text": {
        "type": "string",
        "description": "Its text, in Markdown"
      },
      "createdAt": {
        "type": "string",
        "description": "When it was written, RFC 3339"
      }
    },
    "required": [
      "id",
      "card",
      "text",
      "createdAt"
    ]
  },
  "annotations": {
    "title": "Comment on a card",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
