{
  "id": "cmd-tasks-task-complete",
  "name": "tasks.task.complete",
  "description": "Completes a task (the target): it moves last into its project's first done status, with when it was completed. Does nothing for a task already in a done status.",
  "kind": "command",
  "version": 1,
  "owner": "app:tasks",
  "spec": {
    "command": "task.complete",
    "title": "Complete a task",
    "description": "Completes a task (the target): it moves last into its project's first done status, with when it was completed. Does nothing for a task already in a done status.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "rec",
    "targetType": "taskItem",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "sq",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "{where: {project: string(state?.project ?? \"0\")}, sort: [{field: \"rank\"}], limit: 100}",
        "type": "json"
      }
    },
    {
      "id": "statuses",
      "type": "records.query",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "tasksStatus"
      }
    },
    {
      "id": "did",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "string(find(statuses ?? [], #.category == \"done\")?._id ?? \"0\")",
        "type": "string"
      }
    },
    {
      "id": "lq",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "{where: {status: did}, sort: [{field: \"rank\", desc: true}], limit: 1}",
        "type": "json"
      }
    },
    {
      "id": "last",
      "type": "records.query",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "entity": "taskItem"
      }
    },
    {
      "id": "clock",
      "type": "data.now",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "type": "json",
        "expr": "let t = state;\nlet cur = find(statuses ?? [], #._id == string(t?.status ?? \"\"));\nlet done = find(statuses ?? [], #.category == \"done\");\nlet tail = first(rows ?? []);\n{problem: t == nil ? \"there is no task \" + target : done == nil ? \"the project has no done status\" : \"\",\n already: (cur?.category ?? \"\") == \"done\",\n after: tail == nil || tail._id == target ? \"\" : tail._id,\n set: {status: done?._id, completedAt: t?.completedAt ?? clock}}"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 2720,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 3060,
        "y": 0
      }
    },
    {
      "id": "already",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 400
      },
      "config": {
        "expr": "plan.already",
        "type": "bool"
      }
    },
    {
      "id": "ifDone",
      "type": "flow.branch",
      "title": "Already done?",
      "position": {
        "x": 3060,
        "y": 200
      }
    },
    {
      "id": "after",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 600
      },
      "config": {
        "expr": "plan.after",
        "type": "string"
      }
    },
    {
      "id": "before",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 400
      },
      "config": {
        "expr": "\"\"",
        "type": "string"
      }
    },
    {
      "id": "set",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 800
      },
      "config": {
        "expr": "plan.set",
        "type": "json"
      }
    },
    {
      "id": "move",
      "type": "records.move",
      "position": {
        "x": 3400,
        "y": 0
      },
      "config": {
        "entity": "taskItem",
        "field": "rank"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
