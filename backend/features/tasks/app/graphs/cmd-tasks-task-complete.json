        "node": "did",
        "pin": "statuses"
      }
    },
    {
      "from": {
        "node": "did",
        "pin": "value"
      },
      "to": {
        "node": "lq",
        "pin": "did"
      }
    },
    {
      "from": {
        "node": "lq",
        "pin": "value"
      },
      "to": {
