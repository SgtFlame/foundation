      "config": {
        "type": "json",
        "expr": "let linked = tk != nil && pr != nil && string(pr.connection ?? \"\") != \"\" && string(pr.board ?? \"\") != \"\";\nlet list = string((st ?? {}).outsideList ?? \"\");\nlet card = tk == nil ? \"\" : string(tk.outsideId ?? \"\");\nlet doc = tk?.description;\nlet text = doc == nil ? \"\" : join(map(doc.content ?? [], join(map(#.content ?? [], string(#.text ?? \"\")), \"\")), \"\\n\\n\");\nlet fields = {title: tk?.title ?? \"\", description: text, due: string(tk?.due ?? \"\")};\nlet snap = tk?.outside?.synced;\nlet same = snap != nil && string(snap.title ?? \"\") == fields.title && string(snap.description ?? \"\") == fields.description && string(snap.due ?? \"\") == fields.due && string(snap.list ?? \"\") == list;\nlet mine = tk != nil && !(force ?? false) && (snap != nil ? same : int(tk._updatedBy ?? 0) == 0);\n{mode: !linked || mine || tk.state == \"proposed\" ? \"skip\" : (card == \"\" ? (list == \"\" ? \"skip\" : \"create\") : \"update\"),\n card: card, list: list, version: string(tk?.outside?.version ?? \"\"), moved: card != \"\" && list != \"\" && list != string(tk?.outside?.list ?? \"\"),\n board: string(pr?.board ?? \"\"), connection: string(pr?.connection ?? \"\"),\n fields: fields}"
      }
