{
  "id": "cmd-todos-project-create",
  "name": "todos.project.create",
  "description": "Makes a Tasks project, its target the new project's id: its name, a short key for task numbers (made from the name when left out), a description, and the people who are members and guests. Its maker administers it. The Tasks app then gives it the statuses To do, Doing, Review and Done, and keeps its admins, members and guests as grants on it.",
  "kind": "command",
  "version": 1,
  "owner": "app:todos",
  "spec": {
    "command": "project.create",
    "title": "New project",
    "description": "Makes a Tasks project, its target the new project's id: its name, a short key for task numbers (made from the name when left out), a description, and the people who are members and guests. Its maker administers it. The Tasks app then gives it the statuses To do, Doing, Review and Done, and keeps its admins, members and guests as grants on it.",
    "args": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The project's name, such as Website relaunch"
        },
        "key": {
          "type": "string",
          "description": "A short prefix for its task numbers, such as WEB"
        },
        "description": {
          "type": "string",
          "description": "What the project is for, in Markdown"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User ids of its members, besides its maker"
        },
        "guests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User ids of its guests, who see this project only"
        }
      },
      "required": [
        "name"
      ]
    },
    "area": "rec",
    "targetType": "tasksProject",
    "projection": "records.record",
    "action": "record.create",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "let a = args;\nlet name = trim(a.name ?? \"\");\nlet letters = upper(replace(name, \" \", \"\"));\nlet key = trim(a.key ?? \"\") != \"\" ? upper(trim(a.key)) : (len(letters) \u003e 3 ? letters[:3] : letters);\nlet makers = me == \"\" ? [] : [me];\nlet members = uniq(concat(makers, map(a.members ?? [], string(#))));\n{problem: state != nil ? \"there is already a project \" + target : name == \"\" ? \"give the project a name, such as Website relaunch\" : \"\",\n projects: [{id: target, values: {name: name, key: key, description: a.description ?? \"\", admins: makers, members: members,\n   guests: filter(map(a.guests ?? [], string(#)), !(# in members)), defaultView: \"board\", archived: false}}]}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1020,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "expr": "plan.projects ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "create tasksProject (projects)",
      "position": {
        "x": 1360,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.create",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "entity": "tasksProject"
      }
    },
    {
      "id": "w0v",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 200
      },
      "config": {
        "expr": "item.values",
        "type": "json"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "me",
        "pin": "user"
      },
