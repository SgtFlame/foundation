{
  "id": "tasks-syncPull",
  "name": "Pull a card from its tracker",
  "description": "The job taking a card's change from a project's tracker board (part 30h), as the app, one at a time per card. An event whose version the task already holds is the echo of our own push and is dropped. A card with no task, on a board a project is connected to, becomes a task. Otherwise the card's title, description, due date, list and archiving are taken. When the task also changed here since the sync last wrote it, the later change wins field by field: the losing values are kept in a sync log entry, and when ours wins the task is pushed back.",
  "kind": "server.action",
  "version": 1,
  "owner": "app:tasks",
  "nodes": [
    {
      "id": "call",
      "type": "event.call",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
