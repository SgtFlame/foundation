    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 3400,
        "y": 0
      },
      "config": {
        "type": "json",
        "expr": "let s = find(statuses ?? [], string(#.outsideList ?? \"\") == list);\nlet theirDue = len(due ?? \"\") \u003e= 10 ? due[:10] : \"\";\nlet out = {id: id, version: version, updatedAt: updatedAt, list: list};\nlet doc = tk?.description;\nlet ourText = doc == nil ? \"\" : join(map(doc.content ?? [], join(map(#.content ?? [], string(#.text ?? \"\")), \"\")), \"\\n\\n\");\nlet theirs = {title: title, description: description ?? \"\", due: theirDue, status: s == nil ? string(tk?.status ?? \"\") : s._id, state: archived ? \"archived\" : string(tk?.state ?? \"active\")};\nlet ours = tk == nil ? {} : {title: tk.title ?? \"\", description: ourText, due: string(tk.due ?? \"\"), status: string(tk.status ?? \"\"), state: string(tk.state ?? \"active\")};\nlet diff = tk == nil ? [] : filter([\"title\", \"description\", \"due\", \"status\", \"state\"], string(ours[#]) != string(theirs[#]));\nlet changedHere = tk != nil \u0026\u0026 int(tk._updatedBy ?? 0) != 0;\nlet theirsLater = !changedHere || updatedAt == \"\" || date(updatedAt) \u003e= date(string(tk._updatedAt));\nlet taken = theirsLater ? diff : [];\nlet asField = {title: theirs.title, due: theirs.due == \"\" ? nil : theirs.due, status: theirs.status, state: theirs.state,\n  description: theirs.description == \"\" ? nil : {type: \"doc\", content: map(split(theirs.description, \"\\n\\n\"), ({type: \"paragraph\", content: [{type: \"text\", text: #}]}))}};\n{mode: tk == nil ? (pid == \"none\" ? \"skip\" : \"create\") : \"merge\",\n create: {project: pid, title: title == \"\" ? \"(untitled)\" : title, description: description ?? \"\", due: theirDue, status: s == nil ? \"\" : s._id, outside: out},\n set: fromPairs(concat([[\"outside\", out]], map(taken, [#, asField[#]]))), expect: tk?._seq,\n conflict: changedHere \u0026\u0026 len(diff) \u003e 0, keptOurs: changedHere \u0026\u0026 len(diff) \u003e 0 \u0026\u0026 !theirsLater,\n log: {project: pid, task: tk?._id, kind: \"conflict\", fields: join(diff, \", \"), kept: theirsLater ? \"theirs\" : \"ours\",\n   lost: toJSON(fromPairs(map(diff, [#, theirsLater ? ours[#] : theirs[#]]))),\n   oursAt: tk?._updatedAt, theirsAt: updatedAt == \"\" ? nil : updatedAt,\n   summary: \"Both sides changed \" + (tk?.title ?? title) + \" (\" + join(diff, \", \") + \"): \" + (theirsLater ? \"the tracker's change\" : \"ours\") + \" was later and kept\"}}"
      }
    },
