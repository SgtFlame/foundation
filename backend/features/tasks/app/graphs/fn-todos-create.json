      },
      "to": {
        "node": "send",
        "pin": "target"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "project"
      },
      "to": {
        "node": "args",
        "pin": "project"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "title"
      },
      "to": {
        "node": "args",
        "pin": "title"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "status"
      },
      "to": {
        "node": "args",
        "pin": "status"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "description"
      },
      "to": {
        "node": "args",
        "pin": "description"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "assignees"
      },
      "to": {
        "node": "args",
        "pin": "assignees"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "due"
      },
      "to": {
        "node": "args",
        "pin": "due"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "priority"
      },
      "to": {
        "node": "args",
        "pin": "priority"
      }
    },
    {
      "from": {
        "node": "call",
        "pin": "source"
      },
      "to": {
        "node": "args",
        "pin": "source"
      }
    },
    {
      "from": {
        "node": "args",
        "pin": "value"
      },
      "to": {
        "node": "send",
        "pin": "args"
      }
    },
    {
      "from": {
        "node": "send",
        "pin": "ok"
      },
      "to": {
        "node": "ok",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "yes",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "made"
      }
    },
    {
      "from": {
        "node": "taskId",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "task"
      }
    },
    {
      "from": {
        "node": "taskId",
        "pin": "value"
      },
      "to": {
        "node": "produced",
        "pin": "taskId"
      }
    },
    {
      "from": {
        "node": "produced",
        "pin": "value"
      },
      "to": {
        "node": "ok",
        "pin": "produced"
      }
    },
    {
      "from": {
        "node": "send",
        "pin": "rejected"
      },
      "to": {
        "node": "refused",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "no",
        "pin": "value"
      },
      "to": {
        "node": "refused",
        "pin": "made"
      }
    },
    {
      "from": {
