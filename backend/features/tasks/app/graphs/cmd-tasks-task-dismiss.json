{
  "id": "cmd-tasks-task-dismiss",
  "name": "tasks.task.dismiss",
  "description": "Dismisses a task an agent proposed (the target): it is archived, kept but no longer shown.",
  "kind": "command",
  "version": 1,
  "owner": "app:tasks",
  "spec": {
    "command": "task.dismiss",
    "title": "Dismiss a proposed task",
    "description": "Dismisses a task an agent proposed (the target): it is archived, kept but no longer shown.",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "rec",
    "targetType": "taskItem",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "{problem: state == nil ? \"there is no task \" + target : state.state != \"proposed\" ? \"the task is not a proposal\" : \"\",\n tasks: [{id: target, set: {state: \"archived\"}, expect: state._seq}]}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1020,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 1360,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "expr": "plan.tasks ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "update taskItem (tasks)",
      "position": {
        "x": 1360,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.update",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "entity": "taskItem"
      }
    },
    {
      "id": "w0s",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 200
      },
      "config": {
        "expr": "item.set",
        "type": "json"
      }
    },
    {
      "id": "w0x",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 400
      },
      "config": {
        "expr": "item.expect",
        "type": "number"
      }
    }
  ],
