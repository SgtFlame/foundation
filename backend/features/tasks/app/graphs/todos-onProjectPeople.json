{
  "id": "todos-onProjectPeople",
  "name": "A project's people changed",
  "description": "Keeps a project's grants in step with its admins, members and guests: enqueues the project's grant sync, one at a time per project, also when the project is deleted",
  "kind": "app.trigger",
  "version": 1,
  "owner": "app:todos",
  "nodes": [
    {
      "id": "event",
      "type": "records.onChanged",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "ownChanges": true,
        "entity": "tasksProject",
        "events": [
          "created",
          "updated",
          "deleted"
        ]
      }
    },
    {
      "id": "changed",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "type": "bool",
        "expr": "let people = [\"admins\", \"members\", \"guests\"];\nkind != \"updated\" || any(people, string((record ?? {})[#] ?? []) != string((old ?? {})[#] ?? []))"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 680,
        "y": 0
      }
    },
    {
      "id": "key",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "expr": "\"people-\" + id",
        "type": "string"
      }
    },
    {
      "id": "inputs",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 400
      },
      "config": {
        "expr": "{project: id, deleted: kind == \"deleted\"}",
        "type": "json"
      }
    },
    {
      "id": "enqueue",
      "type": "jobs.enqueue",
      "title": "Sync the project's grants",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "graph": "todos-syncAccess"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "event",
        "pin": "event"
      },
      "to": {
        "node": "changed",
        "pin": "kind"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "record"
      },
      "to": {
        "node": "changed",
        "pin": "record"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "old"
      },
      "to": {
        "node": "changed",
        "pin": "old"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "then"
      },
      "to": {
        "node": "if",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "changed",
        "pin": "value"
      },
      "to": {
        "node": "if",
        "pin": "condition"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "id"
      },
      "to": {
        "node": "key",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "id"
      },
      "to": {
        "node": "inputs",
        "pin": "id"
      }
    },
    {
      "from": {
        "node": "event",
        "pin": "event"
      },
      "to": {
        "node": "inputs",
        "pin": "kind"
      }
    },
    {
      "from": {
        "node": "if",
        "pin": "true"
      },
      "to": {
        "node": "enqueue",
        "pin": "then"
      }
    },
    {
      "from": {
        "node": "key",
        "pin": "value"
      },
      "to": {
        "node": "enqueue",
        "pin": "key"
      }
    },
    {
      "from": {
        "node": "inputs",
        "pin": "value"
      },
      "to": {
        "node": "enqueue",
        "pin": "inputs"
      }
    }
  ]
}
