{
  "id": "cmd-tasks-task-create",
  "name": "tasks.task.create",
  "description": "Makes a task in a project, its target the new task's id, last in its status (the project's first to-do status when left out): its title, a plain-text description, assignees (user ids), due and start dates (YYYY-MM-DD), a priority (none, low, medium, high, urgent), labels, a parent task, and the source it came from ({link, title, kind}, a workbench link to a mail thread, a message or an event). Made by an agent whose autonomy is suggest (or unset), it is a proposal until a person accepts it; with autonomy draft, an active task.",
  "kind": "command",
  "version": 1,
  "owner": "app:tasks",
  "spec": {
    "command": "task.create",
    "title": "New task",
    "description": "Makes a task in a project, its target the new task's id, last in its status (the project's first to-do status when left out): its title, a plain-text description, assignees (user ids), due and start dates (YYYY-MM-DD), a priority (none, low, medium, high, urgent), labels, a parent task, and the source it came from ({link, title, kind}, a workbench link to a mail thread, a message or an event). Made by an agent whose autonomy is suggest (or unset), it is a proposal until a person accepts it; with autonomy draft, an active task.",
    "args": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "description": "The project's id"
        },
        "title": {
          "type": "string",
          "description": "What is to be done"
        },
        "status": {
          "type": "string",
          "description": "The status's id; the project's first to-do status when left out"
        },
        "description": {
          "type": "string",
          "description": "More about it, as plain text"
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User ids of the people who do it"
        },
        "due": {
          "type": "string",
          "description": "When it is due, YYYY-MM-DD"
        },
        "start": {
          "type": "string",
          "description": "When work on it starts, YYYY-MM-DD"
        },
        "priority": {
          "type": "string",
          "description": "none, low, medium, high or urgent"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Label ids of the project"
        },
        "parent": {
          "type": "string",
          "description": "The id of the task it is part of"
        },
        "source": {
          "type": "object",
          "description": "What it came from: {link, title, kind}"
        }
      },
      "required": [
        "project",
        "title"
      ]
    },
    "area": "rec",
    "targetType": "taskItem",
    "projection": "records.record",
    "action": "record.create",
    "events": [
      "created",
      "updated",
      "deleted"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "me",
      "type": "live.currentUser",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "pid",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "trim(string(args.project ?? \"\")) == \"\" ? \"none\" : trim(string(args.project))",
        "type": "string"
      }
    },
    {
      "id": "project",
      "type": "records.get",
      "position": {
        "x": 680,
        "y": 0
      },
      "config": {
        "entity": "tasksProject"
      }
    },
    {
      "id": "sq",
      "type": "data.expression",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "expr": "{where: {project: pid}, sort: [{field: \"rank\"}], limit: 100}",
        "type": "json"
      }
    },
    {
      "id": "statuses",
      "type": "records.query",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "entity": "tasksStatus"
      }
    },
    {
      "id": "sid",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "type": "string",
        "expr": "let want = string(args.status ?? \"\");\nlet st = want != \"\" ? find(statuses ?? [], #._id == want) : (find(statuses ?? [], #.category == \"todo\") ?? first(statuses ?? []));\nst == nil ? \"\" : st._id"
      }
    },
    {
      "id": "lq",
      "type": "data.expression",
      "position": {
        "x": 1700,
        "y": 0
      },
      "config": {
        "expr": "{where: {status: sid == \"\" ? \"0\" : sid}, sort: [{field: \"rank\", desc: true}], limit: 1}",
        "type": "json"
      }
    },
    {
      "id": "last",
      "type": "records.query",
      "position": {
        "x": 2040,
        "y": 0
      },
      "config": {
        "entity": "taskItem"
      }
    },
    {
      "id": "lastRank",
      "type": "data.expression",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "expr": "string(first(rows ?? [])?.rank ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "none",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 400
      },
      "config": {
        "expr": "\"\"",
        "type": "string"
      }
    },
    {
      "id": "rank",
      "type": "records.rankBetween",
      "position": {
        "x": 2720,
        "y": 0
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 3060,
        "y": 0
      },
      "config": {
        "expr": "let a = args;\nlet title = trim(a.title ?? \"\");\nlet isAgent = kind == \"agent\";\nlet autonomy = string(agentRecord?.autonomy ?? \"suggest\");\nlet proposed = isAgent \u0026\u0026 autonomy == \"suggest\";\nlet text = trim(a.description ?? \"\");\nlet doc = text == \"\" ? nil : {type: \"doc\", content: map(split(text, \"\\n\\n\"), ({type: \"paragraph\", content: [{type: \"text\", text: #}]}))};\nlet given = {description: doc, assignees: a.assignees, due: a.due, start: a.start, priority: a.priority, labels: a.labels, parent: a.parent, source: a.source};\nlet vals = fromPairs(concat(\n  [[\"title\", title], [\"project\", pid], [\"status\", sid], [\"rank\", rank], [\"state\", proposed ? \"proposed\" : \"active\"], [\"proposedBy\", isAgent ? \"agent:\" + agent : \"\"]],\n  filter(toPairs(given), #[1] != nil \u0026\u0026 #[1] != \"\")));\n{problem: state != nil ? \"there is already a task \" + target\n   : title == \"\" ? \"give the task a title\"\n   : project == nil ? \"there is no project \" + pid + \" you may see\"\n   : sid == \"\" ? (string(a.status ?? \"\") != \"\" ? \"the project has no status \" + string(a.status) : \"the project has no statuses yet\")\n   : \"\",\n tasks: [{id: target, values: vals}]}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 3400,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 3740,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 3400,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 4080,
        "y": 0
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 3400,
        "y": 400
      },
      "config": {
        "expr": "plan.tasks ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "create taskItem (tasks)",
      "position": {
        "x": 4080,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 4420,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.create",
      "position": {
        "x": 4760,
        "y": 0
      },
      "config": {
        "entity": "taskItem"
      }
    },
    {
      "id": "w0v",
      "type": "data.expression",
      "position": {
        "x": 4420,
        "y": 200
      },
      "config": {
        "expr": "item.values",
        "type": "json"
      }
    }
  ],
