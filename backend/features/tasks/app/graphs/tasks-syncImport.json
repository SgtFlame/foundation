      "id": "updList",
      "type": "data.expression",
      "position": {
        "x": 3060,
        "y": 0
      },
      "config": {
        "expr": "plan.updates",
        "type": "json"
      }
    },
    {
      "id": "updates",
      "type": "flow.forEach",
      "title": "Each status to map",
      "position": {
        "x": 3400,
        "y": 0
      }
    },
