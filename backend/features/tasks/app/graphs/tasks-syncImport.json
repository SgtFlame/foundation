{
  "id": "tasks-syncImport",
  "name": "Import a project's board",
  "description": "The job importing a project's tracker board (part 30h), as the app, one at a time per project. Its first run (cursor empty) maps the board's lists to the project's statuses, by tracker list or by name, making a status for each list with none, marks the sync importing and enqueues the first page. Each later run imports one page of cards (card.list) as tasks with their outside card, skipping cards already imported, and enqueues the next page; the last marks the sync ok. A non-retryable tracker error marks the sync failed with its message; a retryable one fails the run, so the job retries it.",
  "kind": "server.action",
  "version": 1,
  "owner": "app:tasks",
  "variables": [
    {
      "id": "prevRank",
      "name": "Previous rank",
      "type": "string",
      "description": "The rank of the status made last, so the next goes after it"
    }
  ],
  "nodes": [
    {
      "id": "call",
      "type": "event.call",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": [
          {
            "id": "project",
            "name": "project",
            "type": "string"
          },
          {
            "id": "cursor",
            "name": "cursor",
            "type": "string",
            "optional": true
          },
          {
            "id": "page",
            "name": "page",
            "type": "number",
            "optional": true
          },
          {
            "id": "imported",
            "name": "imported",
            "type": "number",
            "optional": true
          }
        ]
      }
    },
    {
      "id": "pid",
      "type": "data.expression",
      "position": {
        "x": 340,
