      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 200
      },
      "config": {
        "expr": "mode == \"map\"",
        "type": "bool"
      }
    },
    {
      "id": "ifMap",
      "type": "flow.branch",
      "position": {
        "x": 2040,
        "y": 200
      }
    },
    {
      "id": "conn",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 200
      },
      "config": {
        "expr": "string(pr.connection)",
        "type": "string"
      }
    },
    {
      "id": "board",
      "type": "data.expression",
