    {
      "id": "getBoard",
      "type": "connector.call",
      "title": "Read the board",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "contract": "tasks.tracker@1",
        "operation": "board.get",
        "connection": true,
        "inputs": [
          {
            "id": "id",
            "name": "id",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "board",
