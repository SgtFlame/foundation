    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 2720,
        "y": 0
      },
      "config": {
        "type": "json",
        "expr": "let open = filter(lists ?? [], !(#.closed ?? false));\nlet st = statuses ?? [];\nlet mapped = map(filter(st, string(#.outsideList ?? \"\") != \"\"), string(#.outsideList));\nlet pend = filter(open, !(#.id in mapped));\nlet upd = filter(map(pend, let l = #; let s = find(st, string(#.outsideList ?? \"\") == \"\" \u0026\u0026 lower(#.name) == lower(l.name)); s == nil ? nil : {id: s._id, set: {outsideList: l.id}}), # != nil);\nlet made = filter(pend, let l = #; none(st, string(#.outsideList ?? \"\") == \"\" \u0026\u0026 lower(#.name) == lower(l.name)));\n{updates: upd,\n creates: map(made, ({project: pid, name: #.name, outsideList: #.id,\n   category: lower(#.name) matches \"done|complete|closed|finished\" ? \"done\" : (lower(#.name) matches \"doing|progress|review|active\" ? \"doing\" : \"todo\")})),\n lastRank: string((last(st) ?? {}).rank ?? \"\")}"
      }
    },
