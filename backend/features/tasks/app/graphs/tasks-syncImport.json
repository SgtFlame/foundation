      "config": {
        "type": "string",
        "expr": "pr == nil || string(pr.connection ?? \"\") == \"\" || string(pr.board ?? \"\") == \"\" ? \"off\" : ((cursor ?? \"\") == \"\" ? \"map\" : \"page\")"
      }
    },
    {
      "id": "isOff",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "mode == \"off\"",
        "type": "bool"
      }
    },
    {
