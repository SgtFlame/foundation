    {
      "id": "pagePlan",
      "type": "data.expression",
      "position": {
        "x": 3400,
        "y": 200
      },
      "config": {
        "type": "json",
        "expr": "let have = map(known ?? [], string(#.outsideId ?? \"\"));\nlet st = pageStatuses ?? [];\nlet fresh = filter(cards ?? [], !(#.id in have) \u0026\u0026 !(#.archived ?? false));\n{tasks: map(fresh, let c = #; let s = find(st, string(#.outsideList ?? \"\") == c.list);\n  fromPairs(filter(toPairs({project: pid, title: c.title == \"\" ? \"(untitled)\" : c.title, description: c.description ?? \"\",\n    due: len(string(c.due ?? \"\")) \u003e= 10 ? string(c.due)[:10] : \"\", status: s == nil ? \"\" : s._id,\n    outside: {id: c.id, version: c.version, updatedAt: c.updatedAt, list: c.list}}), #[1] != nil \u0026\u0026 #[1] != \"\"))),\n next: string(next ?? \"\"), count: len(fresh)}"
      }
