{
  "name": "test_echo_echo",
  "description": "Gives the text back, repeated, with its length and the adapter instance that served it",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "The text to echo"
      },
      "repeat": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "description": "How many times; once when left out"
      },
      "options": {
        "type": "object",
        "description": "Nested options, one pin",
        "properties": {
          "upper": {
            "type": "boolean",
            "description": "In capitals"
          }
        }
      }
    },
    "required": [
      "text"
    ]
  }
}
