{
  "id": "cmd-docs-page-restore",
  "name": "docs.page.restore",
  "description": "Brings a page back from the trash with the subpages that went with it, as one batch. When its parent is still there it goes back where it was and is counted on its parent again; when its parent is in the trash or gone it goes to the top of its Volume, and its subpages' ancestors follow.",
  "kind": "command",
  "version": 1,
  "owner": "app:docs",
  "spec": {
    "command": "page.restore",
    "title": "Restore a page",
    "description": "Brings the target page back from the trash, with the subpages trashed with it",
    "args": {
      "type": "object",
      "properties": {}
    },
    "area": "rec",
    "targetType": "docsPage",
    "projection": "records.record",
    "action": "record.update",
    "events": [
      "updated"
    ]
  },
  "nodes": [
    {
      "id": "event",
      "type": "live.onCommand",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "outputs": []
      }
    },
    {
      "id": "volumeId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 0
      },
      "config": {
        "expr": "string(state?.volume ?? \"\")",
        "type": "string"
      }
    },
    {
      "id": "write",
      "type": "data.expression",
      "position": {
        "x": 0,
        "y": 200
      },
      "config": {
        "expr": "\"write\"",
        "type": "string"
      }
    },
    {
      "id": "may",
      "type": "docs.mayUseVolume",
      "position": {
        "x": 680,
        "y": 0
      }
    },
    {
      "id": "parentId",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 200
      },
      "config": {
        "expr": "string(state?.parent ?? \"\") == \"\" ? \"none\" : string(state.parent)",
        "type": "string"
      }
    },
    {
      "id": "parent",
      "type": "records.get",
      "position": {
        "x": 680,
        "y": 200
      },
      "config": {
        "entity": "docsPage"
      }
    },
    {
      "id": "groupQ",
      "type": "data.expression",
      "position": {
        "x": 340,
        "y": 400
      },
      "config": {
        "expr": "{filter: {\"and\": [{field: \"ancestors\", op: \"contains\", value: target}, {field: \"trashedWith\", value: string(state?.trashedWith ?? \"-\")}]}, fields: [\"ancestors\"]}",
        "type": "json"
      }
    },
    {
      "id": "group",
      "type": "records.query",
      "title": "Its subpages trashed with it",
      "position": {
        "x": 680,
        "y": 400
      },
      "config": {
        "entity": "docsPage"
      }
    },
    {
      "id": "plan",
      "type": "data.expression",
      "position": {
        "x": 1020,
        "y": 0
      },
      "config": {
        "expr": "let back = {trashedAt: nil, trashedWith: nil};\nlet p = string(state?.parent ?? \"\");\nlet home = p != \"\" \u0026\u0026 parent != nil \u0026\u0026 parent.trashedAt == nil;\n{problem: state == nil ? \"there is no page \" + target\n  : state.trashedAt == nil ? \"the page is not in the trash\"\n  : !may ? \"you may not change the pages of Volume \" + string(state.volume ?? \"\") : \"\",\n home: home,\n top: {parent: nil, ancestors: [], trashedAt: nil, trashedWith: nil},\n updates: concat(home ? [{id: target, set: back}] : [],\n   map(group ?? [], { let d = #; let a = map(d.ancestors ?? [], string(#));\n     ({id: string(d._id), set: home ? back : {trashedAt: nil, trashedWith: nil, ancestors: a[findIndex(a, # == target):]}}) }),\n   home ? [{id: p, set: {childCount: int(parent.childCount ?? 0) + 1}, expect: parent._seq}] : [])}",
        "type": "json"
      }
    },
    {
      "id": "refused",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 0
      },
      "config": {
        "expr": "plan.problem != \"\"",
        "type": "bool"
      }
    },
    {
      "id": "if",
      "type": "flow.branch",
      "position": {
        "x": 1700,
        "y": 0
      }
    },
    {
      "id": "why",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 200
      },
      "config": {
        "expr": "plan.problem",
        "type": "string"
      }
    },
    {
      "id": "no",
      "type": "live.reject",
      "position": {
        "x": 2040,
        "y": 0
      }
    },
    {
      "id": "isHome",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 400
      },
      "config": {
        "expr": "plan.home",
        "type": "bool"
      }
    },
    {
      "id": "where",
      "type": "flow.branch",
      "title": "Back where it was, or to the top",
      "position": {
        "x": 2040,
        "y": 200
      }
    },
    {
      "id": "topSet",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 600
      },
      "config": {
        "expr": "plan.top",
        "type": "json"
      }
    },
    {
      "id": "mv",
      "type": "records.move",
      "title": "To the top of its Volume",
      "position": {
        "x": 2380,
        "y": 0
      },
      "config": {
        "entity": "docsPage",
        "field": "rank"
      }
    },
    {
      "id": "w0list",
      "type": "data.expression",
      "position": {
        "x": 1360,
        "y": 800
      },
      "config": {
        "expr": "plan.updates ?? []",
        "type": "json"
      }
    },
    {
      "id": "w0",
      "type": "flow.forEach",
      "title": "back where it was",
      "position": {
        "x": 2380,
        "y": 200
      }
    },
    {
      "id": "w0id",
      "type": "data.expression",
      "position": {
        "x": 2720,
        "y": 0
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w0w",
      "type": "records.update",
      "position": {
        "x": 3060,
        "y": 0
      },
      "config": {
        "entity": "docsPage"
      }
    },
    {
      "id": "w0s",
      "type": "data.expression",
      "position": {
        "x": 2720,
        "y": 200
      },
      "config": {
        "expr": "item.set",
        "type": "json"
      }
    },
    {
      "id": "w0x",
      "type": "data.expression",
      "position": {
        "x": 2720,
        "y": 400
      },
      "config": {
        "expr": "item.expect",
        "type": "number"
      }
    },
    {
      "id": "w1",
      "type": "flow.forEach",
      "title": "its subpages, after it went to the top",
      "position": {
        "x": 2720,
        "y": 600
      }
    },
    {
      "id": "w1id",
      "type": "data.expression",
      "position": {
        "x": 3060,
        "y": 200
      },
      "config": {
        "expr": "item.id",
        "type": "string"
      }
    },
    {
      "id": "w1w",
      "type": "records.update",
      "position": {
        "x": 3400,
        "y": 0
      },
      "config": {
        "entity": "docsPage"
      }
    },
    {
      "id": "w1s",
      "type": "data.expression",
      "position": {
        "x": 3060,
        "y": 400
      },
      "config": {
        "expr": "item.set",
        "type": "json"
      }
    }
  ],
