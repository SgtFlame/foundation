    {"from": {"node": "update?", "pin": "true"}, "to": {"node": "update", "pin": "then"}},
    {"from": {"node": "onReply", "pin": "round"}, "to": {"node": "update", "pin": "round"}},
    {"from": {"node": "onReply", "pin": "segments"}, "to": {"node": "used", "pin": "segments"}},
