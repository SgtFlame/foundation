    {"id": "update", "type": "chronicle.update", "position": {"x": 960, "y": 620}, "config": {"maxProposals": 3}},
    {"id": "returnChanges", "type": "flow.return", "title": "Return changes", "position": {"x": 1300, "y": 620},
      "config": {"outputs": [{"id": "changes", "name": "Changes", "type": "Changes"}]}}
  ],
  "edges": [
    {"from": {"node": "onMessage", "pin": "then"}, "to": {"node": "candidates", "pin": "then"}},
    {"from": {"node": "onMessage", "pin": "settings"}, "to": {"node": "settings", "pin": "settings"}},
    {"from": {"node": "onMessage", "pin": "text"}, "to": {"node": "candidates", "pin": "text"}},
    {"from": {"node": "onMessage", "pin": "window"}, "to": {"node": "candidates", "pin": "window"}},
    {"from": {"node": "settings", "pin": "checked"}, "to": {"node": "candidates", "pin": "checked"}},
    {"from": {"node": "settings", "pin": "retrieve"}, "to": {"node": "candidates", "pin": "retrieve"}},
    {"from": {"node": "candidates", "pin": "then"}, "to": {"node": "match", "pin": "then"}},
    {"from": {"node": "onMessage", "pin": "text"}, "to": {"node": "match", "pin": "text"}},
    {"from": {"node": "onMessage", "pin": "window"}, "to": {"node": "match", "pin": "window"}},
    {"from": {"node": "candidates", "pin": "candidates"}, "to": {"node": "match", "pin": "candidates"}},
    {"from": {"node": "settings", "pin": "topK"}, "to": {"node": "match", "pin": "topK"}},
    {"from": {"node": "settings", "pin": "match"}, "to": {"node": "match", "pin": "match"}},
    {"from": {"node": "match", "pin": "selection"}, "to": {"node": "items", "pin": "selection"}},
    {"from": {"node": "match", "pin": "then"}, "to": {"node": "returnItems", "pin": "then"}},
