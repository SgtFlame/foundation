{
  "name": "Personal",
  "description": "The default chat mode: chooses the Chronicle entries each message needs, and keeps them up to date after each reply.",
  "kind": "mode",
  "version": 1,
  "nodes": [
    {"id": "onMessage", "type": "event.userMessage", "position": {"x": 0, "y": 40}},
    {"id": "settings", "type": "chronicle.settings", "position": {"x": 300, "y": 300}},
    {"id": "candidates", "type": "chronicle.candidates", "position": {"x": 620, "y": 0}},
    {"id": "match", "type": "chronicle.match", "position": {"x": 960, "y": 0}},
